{
  "mcpServers": {
    "ghidra-mcp": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/absolute/path/to/ghidra-mcp",
        "bridge-mcp-ghidra",
        "--transport",
        "stdio"
      ],
      "env": {
        "GHIDRA_MCP_BRIDGE_SERVER_URL": "http://127.0.0.1:8089",
        "PYTHONIOENCODING": "utf-8"
      }
    }
  }
}
