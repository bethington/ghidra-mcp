        {
          "description": "Path of the file whose checkout is being terminated.",
          "name": "path",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Numeric checkout id to terminate, as /server/checkouts reports it. Headless mode only, and defaults to 0 when absent; the GUI plugin terminates by path alone.",
          "name": "checkoutId",
