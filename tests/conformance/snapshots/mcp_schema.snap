      "description": "Interrupt (break into) the running target",
      "method": "POST",
      "params": [],
      "path": "/debugger/interrupt"
    },
    {
      "category": "debugger",
      "category_description": "Live debugging: attach, breakpoints, step, registers, memory. Requires a CodeBrowser with Debugger view open.",
