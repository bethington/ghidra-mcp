    },
    {
      "category": "datatype",
      "category_description": "Struct/enum/union CRUD, apply data types, type conflicts, validation",
      "description": "Create a type built on another: a typedef alias, an array or a pointer. An existing same-named type is replaced.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "What to build: typedef (an alias, needs name), array (needs length) or pointer.",
          "name": "kind",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Type the new one is built on: what a typedef resolves to, the array's element type, or the pointee. Resolution is recursive, so pointer chains (int**), array syntax (dword[16]), well-known C types and existing struct/enum names all work; `void` is Ghidra's void type.",
          "name": "base_type",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Name for the type. Required for a typedef. For an array or pointer, omit to let Ghidra name it after the base type (dword[16], MyStruct *); the response reports the name actually used.",
          "name": "name",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "1",
          "description": "Array only: number of ELEMENTS, not bytes — total size is length x sizeof(base_type). Must be positive.",
          "name": "length",
          "required": false,
          "source": "body",
          "type": "integer"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/create_derived_type",
      "read_only": false
    },
    {
      "category": "datatype",
      "category_description": "Struct/enum/union CRUD, apply data types, type conflicts, validation",
      "description": "Create an enum data type",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "New enum type name, e.g. UnitType. Creation FAILS if a type with this name already exists — delete it first or choose another name.",
          "name": "name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "JSON object mapping member name to integer value, e.g. {\"UNIT_PLAYER\": 0, \"UNIT_MONSTER\": 1}. Values may be numbers, decimal strings, or 0x-prefixed hex strings; floats and non-numeric strings are rejected. Member names are checked for UPPERCASE_SNAKE_CASE and any complaint comes back as a warning, not a failure.",
          "name": "values",
          "required": true,
          "source": "body",
          "type": "json"
        },
        {
          "default": "4",
          "description": "Storage width of the enum in BYTES — 1, 2, 4 or 8 only (default 4). Anything else is rejected.",
          "name": "size",
          "required": false,
          "source": "body",
          "type": "integer"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/create_enum",
      "read_only": false
    },
    {
      "category": "project",
      "category_description": "Program management, script execution, memory read, bookmarks, save",
      "description": "Create a folder in the project",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Project folder path to create",
          "name": "path",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/create_folder",
      "read_only": false
    },
    {
      "category": "function",
      "category_description": "Decompile, rename, prototype, variables, batch rename, create/delete functions",
      "description": "Create function at address. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Optional name for the new function; leave empty to keep Ghidra's generated FUN_<address>. Written directly, so the naming-quality gate does not run here — use rename_function if you want it to.",
          "name": "name",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "true",
          "description": "True (the default) disassembles the entry address first when no instruction exists there, which is what lets you create a function over raw undefined bytes. False requires the address to be disassembled already; function creation fails otherwise.",
          "name": "disassemble_first",
          "required": false,
          "source": "body",
          "type": "boolean"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/create_function",
      "read_only": false
    },
    {
      "category": "datatype",
      "category_description": "Struct/enum/union CRUD, apply data types, type conflicts, validation",
      "description": "Create a function signature data type",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Name for the function-definition type. This creates a SIGNATURE in the data type manager; it changes no function in the listing.",
          "name": "name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Return type, resolved recursively (pointer chains, arrays, struct names). Required — pass `void` for no return value.",
          "name": "return_type",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "JSON array of parameter objects, e.g. [{\"name\":\"dwId\",\"type\":\"uint\"},{\"name\":\"pUnit\",\"type\":\"void *\"}]. Only the TYPES are used: parameter names are discarded and the created signature has unnamed arguments. Parsing is a plain comma/colon split, so a type containing a comma or a colon does not survive it, and a parameter whose type cannot be resolved is dropped silently.",
          "name": "parameters",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/create_function_signature",
      "read_only": false
    },
    {
      "category": "symbol",
      "category_description": "Create/rename/delete labels, rename data, globals, external locations",
      "description": "Create ONE label (address + name) OR MANY in one call (labels=[{address,name}, ...]). On programs with multiple address spaces, prefix addresses with the space name (mem:1000). Replaces batch_create_labels.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "default": "",
          "description": "Address (single mode). 0x<hex> or <space>:<hex>. Omit when using labels[].",
          "name": "address",
          "param_type": "address",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Label name (single mode).",
          "name": "name",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "[]",
          "description": "Bulk mode: array of {address, name} objects. When non-empty, address/name are ignored.",
          "name": "labels",
          "required": false,
          "source": "body",
          "type": "array"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/create_label",
      "read_only": false
    },
    {
      "category": "program",
      "category_description": "Program management, script execution, memory read, bookmarks, save",
      "description": "Create a new memory block, optionally initialized with byte contents supplied as hex or base64. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Name for the new block as it appears in the memory map, e.g. MMIO or PERIPH. Required.",
          "name": "name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "0",
          "description": "Block length in bytes. Omit (or 0) when byte content is supplied to size the block to the content exactly. If larger than the content, the remainder is filled with fill_byte. Must be positive when no content is supplied. Outside an overlay, address..address+size-1 must not overlap an existing block.",
          "name": "size",
          "required": false,
          "source": "body",
          "type": "integer"
        },
        {
          "default": "true",
          "description": "Read permission on the new block (default true); the r in the response's `permissions` string.",
          "name": "read",
          "required": false,
          "source": "body",
          "type": "boolean"
        },
        {
          "default": "true",
          "description": "Write permission on the new block (default true); the w in the response's `permissions` string.",
          "name": "write",
          "required": false,
          "source": "body",
          "type": "boolean"
        },
        {
          "default": "false",
          "description": "Execute permission, default FALSE. Set true only for a code region — leaving it false is what keeps disassembly out of a data or MMIO block.",
          "name": "execute",
          "required": false,
          "source": "body",
          "type": "boolean"
        },
        {
          "default": "false",
          "description": "Marks the block volatile (default false): its contents can change outside program flow, so the decompiler stops folding repeated reads away. Set this for MMIO and peripheral register regions.",
          "name": "volatile",
          "required": false,
          "source": "body",
          "type": "boolean"
        },
        {
          "default": "",
          "description": "Optional comment stored on the memory block itself. Empty (the default) leaves it unset.",
          "name": "comment",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Block contents as a hex string, e.g. \"deadbeef\" or \"de ad be ef\". Whitespace, commas and a leading 0x are ignored. Supplying content forces initialized=true. Max 16777216 decoded bytes. Mutually exclusive with bytes_base64.",
          "name": "bytes_hex",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Block contents as a standard base64 string — preferred over bytes_hex for large or fully binary payloads. Supplying content forces initialized=true. Max 16777216 decoded bytes. Mutually exclusive with bytes_hex.",
          "name": "bytes_base64",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "false",
          "description": "Create an initialized block (real bytes backed by the program database) rather than an uninitialized one. Implied true when byte content is supplied. An initialized block is capped at 268435456 bytes; leave it false for larger MMIO apertures.",
          "name": "initialized",
          "required": false,
          "source": "body",
          "type": "boolean"
        },
        {
          "default": "0",
          "description": "Byte value (0-255) for every byte of an initialized block not covered by the supplied content. Defaults to 0, which Ghidra stores most compactly.",
          "name": "fill_byte",
          "required": false,
          "source": "body",
          "type": "integer"
        },
        {
          "default": "false",
          "description": "Create the block in a new overlay address space instead of the program's physical memory. Use this to map a region that deliberately overlaps existing blocks (bank switching, ROM shadowing); the overlap check is skipped and the response reports the generated overlay space in address_space.",
          "name": "overlay",
          "required": false,
          "source": "body",
          "type": "boolean"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/create_memory_block",
      "read_only": false
    },
    {
      "category": "program",
      "category_description": "Program management, script execution, memory read, bookmarks, save",
      "description": "Create a user property map to store typed values keyed by address. Types: int, long, string, void (address-presence tag). Use a string map holding JSON to store arbitrary structured per-address data. Call save_program to persist.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Unique map name.",
          "name": "name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "string",
          "description": "Value type: int, long, string, or void.",
          "name": "type",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/create_property_map",
      "read_only": false
    },
    {
      "category": "datatype",
      "category_description": "Struct/enum/union CRUD, apply data types, type conflicts, validation",
      "description": "Create a structure data type. Body fields must be a JSON array of objects; each object needs name and type, with optional offset. Example fields: [{\"name\":\"dwId\",\"type\":\"uint\",\"offset\":0},{\"name\":\"pNext\",\"type\":\"void *\",\"offset\":4}]. Type may be any resolvable Ghidra data type or existing struct name. Set replace_placeholder=true to delete a 1-byte demangler/placeholder type with the same name before creating. To change size of an existing struct in place, use resize_struct; for atomic delete+recreate, use recreate_struct (see docs/STRUCT_RESIZE_WORKFLOW.md).",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "New structure type name, for example ConfigEntry or SkillTableEntry",
          "name": "name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "JSON array of field objects. Required keys: name, type. Optional key: offset as a decimal byte offset. Alternate keys are accepted: field_name/fieldName, field_type/fieldType/data_type/dataType, field_offset/fieldOffset/off. Example: [{\"name\":\"dwId\",\"type\":\"uint\",\"offset\":0},{\"name\":\"pNext\",\"type\":\"void *\",\"offset\":4}]",
          "name": "fields",
          "required": true,
          "source": "body",
          "type": "json"
        },
        {
          "default": "false",
          "description": "If true and a same-named type exists with size <= 1 byte (typical /Demangler stub), delete it first then create the struct.",
          "name": "replace_placeholder",
          "required": false,
          "source": "body",
          "type": "boolean"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/create_struct",
      "read_only": false
    },
    {
      "category": "datatype",
      "category_description": "Struct/enum/union CRUD, apply data types, type conflicts, validation",
      "description": "Create a union data type",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "New union type name. An existing same-named type is REPLACED here, unlike create_enum, which refuses.",
          "name": "name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "JSON array of member objects, same shape as create_struct: required keys name and type; field_name/fieldName and field_type/fieldType/data_type/dataType are accepted as alternates. Any offset key is IGNORED — union members all start at 0. A member whose type cannot be resolved is skipped and reported under fields_skipped instead of failing the call. Names get the project's Hungarian prefix applied automatically.",
          "name": "fields",
          "required": true,
          "source": "body",
          "type": "json"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/create_union",
      "read_only": false
    },
