    {
      "category": "getter",
      "category_description": "Program management, script execution, memory read, bookmarks, save",
      "description": "What the analyst is looking at right now: cursor address, the function under it, the listing selection, and the focused program — one call instead of four. type=address|function|selection|program|all (default all). Takes NO program parameter: the focused program is an answer this reports, not an input. Headless has no analyst and no cursor, so every facet reports null with a reason there — use the program parameter on a data endpoint instead. Replaces get_current_address, get_current_function, get_current_selection and get_current_program_info.",
      "destructive": false,
      "method": "GET",
      "params": [
        {
          "default": "all",
          "description": "Which facet: address | function | selection | program | all",
          "name": "type",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/get_ui_cursor",
      "read_only": true
    },
    {
      "category": "datatype",
      "category_description": "Struct/enum/union CRUD, apply data types, type conflicts, validation",
      "description": "List valid Ghidra data type strings",
      "destructive": false,
      "method": "GET",
      "params": [
        {
          "description": "Category filter",
          "name": "category",
          "required": true,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/get_valid_data_types",
      "read_only": true
    },
    {
      "category": "xref",
      "category_description": "Cross-references, call graphs, incoming/outgoing calls, data refs",
      "description": "Get cross-references from an address. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "destructive": false,
      "method": "GET",
      "params": [
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "address",
          "param_type": "address",
          "required": true,
          "source": "query",
          "type": "string"
        },
        {
          "default": "0",
          "description": "Number of entries to skip before this page starts; 0 begins at the first entry. Page by adding `limit` each call until offset reaches the `total` the response reports.",
          "name": "offset",
          "required": false,
          "source": "query",
          "type": "integer"
        },
        {
          "default": "100",
          "description": "Maximum entries returned in this page (default 100). Pass 0 or a negative value for no limit; `total` in the response always reports the full unpaged count.",
          "name": "limit",
          "required": false,
          "source": "query",
          "type": "integer"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/get_xrefs_from",
      "read_only": true
    },
    {
      "category": "xref",
      "category_description": "Cross-references, call graphs, incoming/outgoing calls, data refs",
      "description": "Get cross-references to ONE address, or to MANY at once (addresses=comma-separated), which returns a map keyed by the address you asked for. Replaces the former get_bulk_xrefs. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "destructive": false,
      "method": "GET",
      "params": [
        {
          "default": "",
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "address",
          "param_type": "address",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "Comma-separated addresses for the many-at-once form. The result is a map of address to its reference list, and an address that does not resolve gets an empty list rather than failing the whole call.",
          "name": "addresses",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "0",
          "description": "Number of entries to skip before this page starts; 0 begins at the first entry. Page by adding `limit` each call until offset reaches the `total` the response reports.",
          "name": "offset",
          "required": false,
          "source": "query",
          "type": "integer"
        },
        {
          "default": "100",
          "description": "Maximum entries returned in this page (default 100). Pass 0 or a negative value for no limit; `total` in the response always reports the full unpaged count.",
          "name": "limit",
          "required": false,
          "source": "query",
          "type": "integer"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/get_xrefs_to",
      "read_only": true
    },
    {
      "category": "datatype",
      "category_description": "Struct/enum/union CRUD, apply data types, type conflicts, validation",
      "description": "Parse C source (structs/unions/enums/typedefs) into the program's data type manager via Ghidra's CParser. Returns how many types were added and any parser messages. Used to load a project's canonical type vocabulary from a generated header.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "C declarations — structs, unions, enums, typedefs — as one string of source TEXT, not a file path. Passed straight to Ghidra's CParser.",
          "name": "source",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "c",
          "description": "Accepted but ignored: parsing is always C through Ghidra's CParser whatever you pass. Kept so existing callers that send it keep working.",
          "name": "format",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/import_data_types",
      "read_only": false
    },
    {
      "category": "program",
      "category_description": "Program management, script execution, memory read, bookmarks, save",
      "description": "Import a binary file from disk into the open project and open it. If the destination folder already holds a file of that name, that file is opened instead (reused_existing: true). For raw firmware binaries, specify language (e.g. 'ARM:LE:32:Cortex') and optionally compiler_spec (e.g. 'default').",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Absolute path to the binary file on disk",
          "name": "file_path",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "/",
          "description": "Destination folder in the Ghidra project",
          "name": "project_folder",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Language ID for raw binaries (e.g. 'ARM:LE:32:Cortex', 'x86:LE:64:default'). If omitted, auto-detect.",
          "name": "language",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Compiler spec ID (e.g. 'default', 'gcc', 'windows'). If omitted, uses language default.",
          "name": "compiler_spec",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "true",
          "description": "Run auto-analysis after import (not run on a reused existing file)",
          "name": "auto_analyze",
          "required": false,
          "source": "body",
          "type": "boolean"
        }
      ],
      "path": "/import_file",
      "read_only": false
    },
    {
      "category": "project",
      "description": "Import a GZF (Ghidra packed-database) file into the open project. The GZF must already exist on disk at `gzf_path` (typically staged on a shared volume by the orchestrator). Lands at `target_folder/target_name` (defaults: `/` and the GZF basename sans `.gzf`). Set `overwrite=true` to replace an existing program at the destination; otherwise the call fails on collision.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Absolute path to the .gzf file on disk.",
          "name": "gzf_path",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "/",
          "description": "Destination folder in the project. Intermediate folders are created.",
          "name": "target_folder",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Destination file name in the project. Defaults to the GZF basename sans `.gzf`.",
          "name": "target_name",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "false",
          "description": "When true, delete any existing program at the destination before importing.",
          "name": "overwrite",
          "required": false,
          "source": "body",
          "type": "boolean"
        }
      ],
      "path": "/import_program",
      "read_only": false
    },
