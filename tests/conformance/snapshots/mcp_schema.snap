      "destructive": false,
      "method": "GET",
      "params": [
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/compare_programs_documentation",
      "read_only": true
    },
    {
      "category": "analysis",
