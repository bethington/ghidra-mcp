    {
      "category": "analysis",
      "category_description": "Completeness analysis, control flow, similarity, crypto detection, memory inspection",
      "description": "Search for instructions by mnemonic and/or operand substring. Complement to /search_byte_patterns (byte-level); this matches after Ghidra has parsed instructions, so you can search for 'mov' + '[ecx+0xD0]' without knowing the encoding. Case-insensitive substring match on both fields. Returns {address, function, mnemonic, operands, bytes} per match.",
      "method": "GET",
      "params": [
        {
          "default": "",
          "description": "Case-insensitive mnemonic match (exact, not substring — 'mov' matches 'MOV' but not 'movsd'). Omit to match any mnemonic.",
          "name": "mnemonic",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "Case-insensitive substring matched against the joined operand string (e.g. '[ecx+0xd0]', 'eax', '0x10001000'). Omit to match any operand.",
          "name": "operand_pattern",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "Restrict search to this function (by name or entry-point address). Omit to search the whole program.",
          "name": "function",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "500",
          "description": "Maximum matches returned. Walking stops as soon as the cap is hit.",
          "name": "limit",
          "required": false,
          "source": "query",
          "type": "integer"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open).",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/search_instructions"
