      "description": "What is checked out under a file or folder of the open project, locally or on the server (with the holders' users and checkout ids). modified_since_checkout says whether a checkout holds uncommitted work, which is what decides if it is safe to release.",
      "destructive": false,
      "method": "GET",
      "params": [
        {
          "default": "/",
          "description": "File or folder to report under. Defaults to / (everything).",
          "name": "path",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/server/checkouts",
      "read_only": true
    },
    {
      "category": "server",
      "description": "Establish the Ghidra Server connection, or report the existing one. Takes no parameters: the GUI's connection is its open project, and headless connects with GHIDRA_SERVER_HOST, GHIDRA_SERVER_PORT, GHIDRA_SERVER_USER and GHIDRA_SERVER_PASSWORD.",
      "destructive": false,
      "method": "POST",
      "params": [],
      "path": "/server/connect",
      "read_only": false
    },
    {
      "category": "server",
      "description": "Disconnect from the Ghidra Server.",
      "destructive": false,
      "method": "POST",
      "params": [],
      "path": "/server/disconnect",
      "read_only": false
    },
    {
      "category": "server",
      "description": "List the repositories on the connected Ghidra Server.",
      "destructive": false,
      "method": "GET",
      "params": [],
      "path": "/server/repositories",
      "read_only": true
    },
    {
      "category": "server",
      "description": "Create a new repository on the connected Ghidra Server (needs admin access).",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Name for the new repository",
          "name": "name",
          "required": true,
          "source": "body",
          "type": "string"
        }
      ],
      "path": "/server/repository/create",
      "read_only": false
    },
    {
      "category": "server",
      "description": "Describe one file of a server repository: name, path, content type, version.",
      "destructive": false,
      "method": "GET",
      "params": [
        {
          "description": "Repository name, as /server/repositories lists them",
          "name": "repo",
          "required": true,
          "source": "query",
          "type": "string"
        },
        {
          "description": "Path of the file to describe",
          "name": "path",
          "required": true,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/server/repository/file",
      "read_only": true
    },
    {
      "category": "server",
      "description": "List the files and folders of a server repository folder. This is the server's own tree; the open project's tree is /list_project_files.",
      "destructive": false,
      "method": "GET",
      "params": [
        {
          "description": "Repository name, as /server/repositories lists them",
          "name": "repo",
          "required": true,
          "source": "query",
          "type": "string"
        },
        {
          "default": "/",
          "description": "Folder to list. Defaults to / (the repository root).",
          "name": "path",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/server/repository/files",
      "read_only": true
    },
    {
      "category": "server",
      "description": "Whether a Ghidra Server is connected (not whether a project is open: see /get_project_info).",
      "destructive": false,
      "method": "GET",
      "params": [],
      "path": "/server/status",
      "read_only": true
    },
    {
      "category": "server",
      "description": "Add a file of the open shared project to version control.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Path of the not-yet-versioned file to add",
          "name": "path",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Comment recorded for the initial version. Defaults to \"Added via GhidraMCP\".",
          "name": "comment",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "false",
          "description": "Keep the file checked out afterwards, so local edits can continue without a second checkout",
          "name": "keep_checked_out",
          "required": false,
          "source": "body",
          "type": "boolean"
        }
      ],
      "path": "/server/version_control/add",
      "read_only": false
    },
    {
      "category": "server",
      "description": "Check out a file of the open shared project into a local working copy. Does not open the program. Requires /open_project on a shared project.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Path of the versioned file to check out",
          "name": "path",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "true",
          "description": "Take an exclusive checkout (the default). False allows others to check the file out concurrently.",
          "name": "exclusive",
          "required": false,
          "source": "body",
          "type": "boolean"
        }
      ],
      "path": "/server/version_control/checkout",
      "read_only": false
    },
    {
      "category": "server",
      "description": "Undo a checkout in the open shared project, discarding local changes that were not checked in. Close the program first: an open file cannot be released.",
      "destructive": true,
      "method": "POST",
      "params": [
        {
          "description": "Path of the checked-out file to release. Any local changes not checked in are discarded.",
          "name": "path",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "false",
          "description": "Keep the local copy as a private file instead of discarding it",
          "name": "keep",
          "required": false,
          "source": "body",
          "type": "boolean"
        }
      ],
      "path": "/server/version_control/undo_checkout",
      "read_only": false
    },
    {
      "category": "server",
      "description": "Version history of a versioned file: version, user, comment and time of each.",
      "destructive": false,
      "method": "GET",
      "params": [
        {
          "description": "Path of the versioned file whose history to return",
          "name": "path",
          "required": true,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/server/version_history",
      "read_only": true
    },
    {
      "category": "program",
      "category_description": "Program management, script execution, memory read, bookmarks, save",
      "description": "Create or update a bookmark. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Bookmark category, free text; empty or omitted becomes the literal `Note`. An existing bookmark at this address in the SAME category is replaced, while a different category adds a second bookmark. Everything here is created under Ghidra's Note bookmark type.",
          "name": "category",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Bookmark text. Empty is allowed and stores an empty comment.",
          "name": "comment",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_bookmark",
      "read_only": false
    },
    {
      "category": "comment",
      "category_description": "Set/get plate, decompiler, disassembly, repeatable comments",
      "description": "Set a listing comment of a given kind at ANY address (data or code). type = plate|pre|eol|post|repeatable (aliases: decompiler=pre, disassembly=eol). Plate writes surface structural warnings and flush the decompiler cache. Symmetric writer for get_comment; replaces the former set_plate_comment / set_decompiler_comment / set_disassembly_comment.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Address in the program (data or code). 0x<hex> or <space>:<hex>.",
          "name": "address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "allow_empty": true,
          "description": "Comment text. An empty string clears this comment kind at the address.",
          "name": "comment",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "plate",
          "description": "Comment kind: plate | pre | eol | post | repeatable (default plate)",
          "name": "type",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_comment",
      "read_only": false
    },
    {
      "category": "function",
      "category_description": "Decompile, rename, prototype, variables, batch rename, create/delete functions",
      "description": "Mark function as no-return. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "function_address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "aliases": [
            "noReturn"
          ],
          "description": "True marks the function non-returning: its call sites become CALL_TERMINATOR, so control-flow analysis and the decompiler stop showing execution continuing past the call. False clears that back to an ordinary returning function. Required — there is no default.",
          "name": "no_return",
          "required": true,
          "source": "body",
          "type": "boolean"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_function_no_return",
      "read_only": false
    },
    {
      "category": "function",
      "category_description": "Decompile, rename, prototype, variables, batch rename, create/delete functions",
      "description": "Set function prototype (return type, parameter types, calling convention) by address. NOTE: the function name in the prototype string is used only for parsing — it does NOT rename the function. To rename, call rename_function separately. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "function_address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Full C signature as one string, e.g. int __fastcall Foo(int nCount, char *pszName). The NAME in it is parsed and then discarded — it does NOT rename the function, call rename_function for that. A calling convention written here is only recognised before the first '(', so one inside a callback parameter type survives untouched.",
          "name": "prototype",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Convention to apply — __cdecl, __stdcall, __fastcall, __thiscall and whatever else list_calling_conventions reports for this program's language. When set it OVERRIDES the convention written into the prototype string; omit to use whatever the prototype says.",
          "name": "calling_convention",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_function_prototype",
      "read_only": false
    },
    {
      "category": "function",
      "category_description": "Decompile, rename, prototype, variables, batch rename, create/delete functions",
      "description": "Update the comment/description on an existing program-wide function tag.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Tag name",
          "name": "name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "New comment text (pass an empty string to clear)",
          "name": "comment",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_function_tag_comment",
      "read_only": false
    },
    {
      "category": "function",
      "category_description": "Decompile, rename, prototype, variables, batch rename, create/delete functions",
      "description": "Type the implicit 'this' of a __thiscall/__fastcall member function by associating the function with its class. Ghidra's auto-'this' (ECX on x86) is an immutable auto-parameter; with auto-storage it derives its type from the function's parent Class namespace, matched by name to a same-named structure. This tool finds/creates a class namespace for the struct and moves the function into it (no custom storage). Pass 'MyClass *' or 'MyClass'; the structure MyClass must already exist (create_struct). On programs with multiple address spaces, prefix function_address with the space name (mem:1000).",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Function entry address (0x<hex> or <space>:<hex>).",
          "name": "function_address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "aliases": [
            "thisType"
          ],
          "description": "Class type for this, e.g. 'MyWidget *' or 'MyWidget'. The base struct name becomes the function's class.",
          "name": "this_type",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_function_this_type",
      "read_only": false
    },
    {
      "category": "datatype",
      "category_description": "Struct/enum/union CRUD, apply data types, type conflicts, validation",
      "description": "Atomically apply name + type + plate-comment + array length to a global variable. Single-transaction; rejects on validation failure with no partial write. Replaces the 4-tool chain (apply_data_type → rename_data → batch_set_comments → create_label).",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Address of the global. Accepts 0x<hex> (default space) or <space>:<hex>.",
          "name": "address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "New name. Must follow g_ + Hungarian + descriptor convention (e.g., g_dwActiveQuestState, g_pUnitList).",
          "name": "name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Ghidra data type to apply (e.g., uint, byte, MyStruct *, char *, MyStruct). Use create_struct/create_derived_type first if the type doesn't exist. Pass empty to leave type unchanged.",
          "name": "type_name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "0",
          "description": "If >0, applied as an array of array_length elements of type_name. Required when documenting an array of fixed length (e.g., a 100-entry data table).",
          "name": "array_length",
          "required": false,
          "source": "body",
          "type": "integer"
        },
        {
          "description": "Plate comment for the address. First line must be a meaningful one-line summary (≥4 words). Optional sectioned details (Used by:, Layout:, Source:, Bitfield:) follow when applicable. Pass empty to leave plate comment unchanged.",
          "name": "plate_comment",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "Optional per-call override for naming enforcement: 'enforce' / 'warn' / 'off'. Omit to use the project/global setting.",
          "name": "strict_mode",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "false",
          "description": "Permit this type application to clear NAMED neighbouring globals out of existence. Default false: the call is rejected with `type_would_evict` plus the list of globals it would destroy. Only set true when the overlap is genuinely wrong and the other symbol should go — the default exists because a silent clear deletes another global's documentation and still reports success.",
          "name": "allow_evict",
          "required": false,
          "source": "body",
          "type": "boolean"
        }
      ],
      "path": "/set_global",
      "read_only": false
    },
    {
      "category": "program",
      "category_description": "Program management, script execution, memory read, bookmarks, save",
      "description": "Set the base address of the program (rebases all addresses)",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "New base address (e.g. 0x08000000)",
          "name": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_image_base",
      "read_only": false
    },
    {
      "category": "program",
      "category_description": "Program management, script execution, memory read, bookmarks, save",
      "description": "Change an existing memory block's permissions or volatility. The one that matters most: firmware loaders often mark the flash block writable, and the decompiler then treats every literal-pool load as a variable (iVar2 = DAT_08016e58) instead of folding it into the constant it holds; marking flash read-only lets peripheral and RAM addresses show as constants or their labels.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "default": "",
          "description": "Block name as the memory map shows it (e.g. ram, FLASH). Give this or address.",
          "name": "block",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Any address inside the block, 0x<hex> or <space>:<hex>. Give this or block.",
          "name": "address",
          "param_type": "address",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "New read permission; omit to leave it as it is.",
          "name": "read",
          "required": false,
          "source": "body",
          "type": "boolean"
        },
        {
          "default": "",
          "description": "New write permission; omit to leave it as it is. false on a flash block is what makes literal-pool constants fold.",
          "name": "write",
          "required": false,
          "source": "body",
          "type": "boolean"
        },
        {
          "default": "",
          "description": "New execute permission; omit to leave it as it is.",
          "name": "execute",
          "required": false,
          "source": "body",
          "type": "boolean"
        },
        {
          "default": "",
          "description": "New volatile flag (contents change outside program flow, e.g. MMIO); omit to leave it as it is.",
          "name": "volatile",
          "required": false,
          "source": "body",
          "type": "boolean"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_memory_block",
      "read_only": false
    },
    {
      "category": "program",
      "category_description": "Program management, script execution, memory read, bookmarks, save",
      "description": "Set a typed program option. If the option already exists its type is reused; otherwise pass type (string|int|long|double|float|boolean). New/custom options are created on demand. Call save_program to persist.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Option group name (e.g. 'Program Information'). Call get_program_options with no group to list them.",
          "name": "group",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Option name within the group.",
          "name": "name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "New value as a string; parsed according to the option type.",
          "name": "value",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Value type: string|int|long|double|float|boolean. Optional when the option already exists (its current type is reused); defaults to string for a brand-new option.",
          "name": "type",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_program_option",
      "read_only": false
    },
    {
      "category": "program",
      "category_description": "Program management, script execution, memory read, bookmarks, save",
      "description": "Set a value at an address in a property map. The value is coerced to the map's type (int/long/string); 'void' maps ignore the value and just tag the address. Create the map first with create_property_map. Call save_program to persist.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Property map name (list them with list_properties and no map).",
          "name": "map",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Value to store, as a string; parsed per the map's type. Ignored for 'void' maps.",
          "name": "value",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_property",
      "read_only": false
    },
    {
      "category": "function",
      "category_description": "Decompile, rename, prototype, variables, batch rename, create/delete functions",
      "description": "Set a parameter's or local's storage location to a register, register pair, or stack slot. Accepts 'EAX', 'EAX:4', 'R0:4,R2:4' or 'Stack[-0x10]:4'; size defaults to the variable's data-type length. Use this when the argument layout cannot be expressed by any calling convention. Setting a PARAMETER's storage switches the whole function to custom variable storage (reported as custom_storage_enabled). The storage is read back after the write and returned in 'storage'. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "aliases": [
            "address",
            "name",
            "function_address",
            "function_name"
          ],
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "function",
          "param_type": "function_ref",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Local or parameter to address, matched by exact name against the function's variables.",
          "name": "variable_name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Storage specification: a location followed by a size in bytes, e.g. Stack[-0x10]:4, EBP:4, EAX:4. The response echoes it as requested_storage next to the variable's current_storage.",
          "name": "storage",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_variable_storage",
      "read_only": false
    },
    {
      "category": "function",
      "category_description": "Decompile, rename, prototype, variables, batch rename, create/delete functions",
      "description": "Set the data type of a function variable (local OR parameter) by name at the decompiler (high-level) layer. Pass variable_name='this' to type a __thiscall/__fastcall implicit this. Replaces set_local_variable_type / set_parameter_type / set_decompiler_variable_type.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Entry address of the function that owns the variable. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00); use get_address_spaces first on targets that are not address-space-agnostic.",
          "name": "function_address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "aliases": [
            "parameter_name"
          ],
          "description": "Local or parameter to retype, named exactly as the decompiler shows it (get_function_variables lists them). The literal value 'this' is special-cased and routes to set_function_this_type.",
          "name": "variable_name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "New data type, resolved recursively (pointer chains, array syntax such as dword[8], existing struct/enum names). A type starting with `undefined` is REJECTED whatever the current type is — swapping one undefined width for another is a no-op, not documentation. For 'this', a bare struct name is auto-suffixed with ' *'.",
          "name": "new_type",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_variable_type",
      "read_only": false
    },
    {
      "category": "function",
      "category_description": "Decompile, rename, prototype, variables, batch rename, create/delete functions",
      "description": "Set types and names for multiple variables atomically. Types are applied first, then renames, in a single transaction. Hungarian prefix validation is enforced: the new name's prefix must match the type. On programs with multiple address spaces, prefix addresses with the space name.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "aliases": [
            "address",
            "name",
            "function_address",
            "function_name"
          ],
          "description": "Function entry point address",
          "name": "function",
          "param_type": "function_ref",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "JSON object mapping old variable names to {name, type} objects. Both fields optional: omit 'type' to rename only, omit 'name' to retype only. Example: {\"local_8\": {\"name\": \"dwFlags\", \"type\": \"uint\"}, \"local_c\": {\"type\": \"int\"}}",
          "name": "variables",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": true,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_variables",
      "read_only": false
    },
    {
      "category": "datatype",
      "category_description": "Struct/enum/union CRUD, apply data types, type conflicts, validation",
      "description": "AI-assisted field name suggestions. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "struct_address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "0",
          "description": "Size of the structure in BYTES, or 0 (the default) to take the size from the data already applied at struct_address. Must be 0 to 65536.",
          "name": "struct_size",
          "required": false,
          "source": "body",
          "type": "integer"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/suggest_field_names",
      "read_only": true
    },
    {
      "category": "program",
      "category_description": "Program management, script execution, memory read, bookmarks, save",
      "description": "Switch MCP context to a different program",
      "destructive": false,
      "method": "GET",
      "params": [
        {
          "description": "Program name to switch to",
          "name": "program",
          "required": true,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/switch_program",
      "read_only": false
    },
    {
      "category": "utility",
      "description": "Move the running CodeBrowser's listing and decompiler to an address, in the program it has current. Reports the function containing the address, if any.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Address to navigate to, as 0x<hex> or <space>:<hex>. It moves a CodeBrowser window, so it needs a running CodeBrowser with a program open.",
          "name": "address",
          "required": true,
          "source": "body",
          "type": "string"
        }
      ],
      "path": "/tool/goto_address",
      "read_only": false
    },
    {
      "category": "utility",
      "description": "The Ghidra tool windows that are running, with each one's current program and open programs when it has a program manager (a CodeBrowser does).",
      "destructive": false,
      "method": "GET",
      "params": [],
      "path": "/tool/running_tools",
      "read_only": true
    },
    {
      "category": "datatype",
      "category_description": "Struct/enum/union CRUD, apply data types, type conflicts, validation",
      "description": "Validate a data type. With an address: checks applicability (memory range, alignment, conflicts) at that address. Without an address: checks only that the type exists, resolving bare names like 'int'/'DWORD'/'char *' across all categories. Replaces validate_data_type_exists.",
      "destructive": false,
      "method": "GET",
      "params": [
        {
          "default": "",
          "description": "Optional address. Omit to check type existence only; provide to validate applicability at that address (memory range/alignment/conflicts). Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00).",
          "name": "address",
          "param_type": "address",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "description": "Data type name (bare names resolve across all categories)",
