    {
      "category": "analysis",
      "category_description": "Completeness analysis, control flow, similarity, crypto detection, memory inspection",
      "description": "Analyze function control flow complexity",
      "destructive": false,
      "method": "GET",
      "params": [
        {
          "description": "Function name",
          "name": "function_name",
          "required": true,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/analyze_control_flow",
      "read_only": true
    },
    {
      "category": "analysis",
      "category_description": "Completeness analysis, control flow, similarity, crypto detection, memory inspection",
      "description": "Comprehensive data region analysis. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "1024",
          "description": "How many BYTES forward from `address` to walk while collecting references and hunting the next named symbol (default 1024). String detection only ever reads the first 256 bytes of whatever the scan covered.",
          "name": "max_scan_bytes",
          "required": false,
          "source": "body",
          "type": "integer"
        },
        {
          "default": "true",
          "description": "True (the default) adds xref_map: a per-byte map from address to the sources referencing it, for every byte in the scanned range that has at least one. False keeps the aggregate counts and drops the map, which is most of the payload on a heavily referenced region.",
          "name": "include_xref_map",
          "required": false,
          "source": "body",
          "type": "boolean"
        },
        {
          "default": "true",
          "description": "True (the default) stops the forward scan at the first named symbol that is not a DAT_ autogen, so the region ends where the next documented global begins. False scans the full max_scan_bytes whatever symbols it crosses.",
          "name": "include_boundary_detection",
          "required": false,
          "source": "body",
          "type": "boolean"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/analyze_data_region",
      "read_only": false
    },
    {
      "category": "analysis",
      "category_description": "Completeness analysis, control flow, similarity, crypto detection, memory inspection",
      "description": "Trace how a value propagates through a function using the decompiler's PCode graph. Direction 'backward' walks producers (Varnode.getDef); 'forward' walks consumers (Varnode.getDescendants). Terminates at constants, parameters, call boundaries, or max_steps. Phi (MULTIEQUAL) nodes are summarized rather than recursed. On programs with multiple address spaces, prefix addresses with the space name (mem:1000).",
      "destructive": false,
      "method": "GET",
      "params": [
        {
          "description": "Address inside the target function where the value is observed. Accepts 0x<hex> or <space>:<hex>.",
          "name": "address",
          "param_type": "address",
          "required": true,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "Anchor selector. Register name (EAX, RCX), HighVariable name (param_1, local_14, iVar1), or empty to use the PcodeOp output at the address.",
          "name": "variable",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "backward",
          "description": "'backward' (producers) or 'forward' (consumers).",
          "name": "direction",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "20",
          "description": "Cap on nodes visited. Default 20, max 200.",
          "name": "max_steps",
          "required": false,
          "source": "query",
          "type": "integer"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/analyze_dataflow",
      "read_only": true
    },
    {
      "category": "analysis",
      "category_description": "Completeness analysis, control flow, similarity, crypto detection, memory inspection",
      "description": "Composite analysis for RE documentation workflow. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "destructive": false,
      "method": "GET",
      "params": [
        {
          "aliases": [
            "address",
            "name",
            "function_address",
            "function_name"
          ],
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "function",
          "param_type": "function_ref",
          "required": true,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/analyze_for_documentation",
      "read_only": true
    },
    {
      "category": "analysis",
      "category_description": "Completeness analysis, control flow, similarity, crypto detection, memory inspection",
      "description": "Comprehensive single-call function analysis. Accepts function name or address. For decompile+callers+comments+xrefs in one read prefer /get_functions.",
      "destructive": false,
      "method": "GET",
      "params": [
        {
          "aliases": [
            "name",
            "address",
            "function_address",
            "function_name"
          ],
          "description": "Function reference (name or address)",
          "name": "function",
          "required": true,
          "source": "query",
          "type": "string"
        },
        {
          "default": "true",
          "description": "True (the default) adds `xrefs` — the sources referencing the entry point — capped at the first 100. `xref_count` counts what was listed, so a value of exactly 100 may mean 'more than 100'; use get_xrefs_to for the true total.",
          "name": "include_xrefs",
          "required": false,
          "source": "query",
          "type": "boolean"
        },
        {
          "default": "true",
          "description": "True (the default) adds `callees`, the names of the functions this one calls, and may add a wrapper_hint when the body is a thin forwarder.",
          "name": "include_callees",
          "required": false,
          "source": "query",
          "type": "boolean"
        },
        {
          "default": "true",
          "description": "True (the default) adds `callers`, the names of the functions that call this one.",
          "name": "include_callers",
          "required": false,
          "source": "query",
          "type": "boolean"
        },
        {
          "default": "true",
          "description": "True (the default) adds `disassembly`: address plus MNEMONIC only, no operands, capped at the first 100 instructions of the body. Use disassemble_function when you need operands or the whole body.",
          "name": "include_disasm",
          "required": false,
          "source": "query",
          "type": "boolean"
        },
        {
          "default": "true",
          "description": "True (the default) adds the function's parameters and locals with their types and storage.",
          "name": "include_variables",
          "required": false,
          "source": "query",
          "type": "boolean"
        },
        {
          "default": "false",
          "description": "Include completeness scoring (undefined vars, naming violations, recommendations)",
          "name": "include_completeness",
          "required": false,
          "source": "query",
          "type": "boolean"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/analyze_function_complete",
      "read_only": true
    },
    {
      "category": "analysis",
      "category_description": "Completeness analysis, control flow, similarity, crypto detection, memory inspection",
      "description": "Check documentation completeness for ONE function (function_address) OR MANY (addresses=comma-separated list). On programs with multiple address spaces, prefix addresses with the space name (mem:1000). Replaces batch_analyze_completeness.",
      "destructive": false,
      "method": "GET",
      "params": [
        {
          "aliases": [
            "address",
            "name",
            "function_address",
            "function_name"
          ],
          "default": "",
          "description": "Function address (single mode). 0x<hex> or <space>:<hex>. Omit when using addresses=.",
          "name": "function",
          "param_type": "function_ref",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "false",
          "description": "Compact output (single mode)",
          "name": "compact",
          "required": false,
          "source": "query",
          "type": "boolean"
        },
        {
          "default": "",
          "description": "Bulk mode: comma-separated addresses. When set, function_address/compact are ignored.",
          "name": "addresses",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/analyze_function_completeness",
      "read_only": true
    },
    {
      "category": "datatype",
      "category_description": "Struct/enum/union CRUD, apply data types, type conflicts, validation",
      "description": "Score a global variable's documentation completeness on a budgeted 0-100 scale — the data-address analog of analyze_function_completeness. Six axes: meaningful name, explanatory plate comment, real type, formatted bytes (core, drive effective_score + DOC_DRAFT) plus enum/equate and struct membership (advanced, forgiven in effective_score). A global with no real type (no defined data, or an undefined* type) is hard-capped at 79 and can never band COMPLETE_80 or above, no matter how good its name and comment are — apply a type with set_global first. Returns raw score, effective_score, COMPLETE_<band>, per-axis breakdown, and which axes are still missing.",
      "destructive": false,
      "method": "GET",
      "params": [
        {
          "description": "Address of the global. Accepts 0x<hex> (default space) or <space>:<hex>.",
          "name": "address",
          "param_type": "address",
          "required": true,
          "source": "query",
          "type": "string"
        },
        {
          "default": "false",
          "description": "Compact output (score/effective/band/missing only)",
          "name": "compact",
          "required": false,
          "source": "query",
          "type": "boolean"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/analyze_global_completeness",
      "read_only": true
    },
    {
      "category": "datatype",
      "category_description": "Struct/enum/union CRUD, apply data types, type conflicts, validation",
      "description": "Analyze structure field access patterns. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Optional label for the structure being analysed. It does NOT select the type — that comes from the data already applied at `address` — and is only echoed back; omit it to use the applied type's own name.",
          "name": "struct_name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "10",
          "description": "How many referencing functions to decompile: 1 to 100, default 10. A value outside that range is REJECTED, not clamped.",
          "name": "max_functions",
          "required": false,
          "source": "body",
          "type": "integer"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/analyze_struct_field_usage",
      "read_only": true
    },
    {
      "category": "datatype",
      "category_description": "Struct/enum/union CRUD, apply data types, type conflicts, validation",
      "description": "Atomic type application with classification. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Which shape to build, matched case-sensitively against exactly PRIMITIVE, STRUCTURE, ARRAY or STRING. Any other value applies NO type at all and the call falls through to the rename and comment steps.",
          "name": "classification",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Optional label to place at the address. Applied only when a data type actually ended up defined there, so it is skipped whenever the classification applied nothing.",
          "name": "name",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Optional PRE comment for the address. Unlike the plate-comment tools, this one DOES turn the two-character escapes for newline, tab and return into real whitespace, so an escaped string arrives as multiple lines.",
          "name": "comment",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "description": "JSON object whose required keys depend on `classification`: PRIMITIVE needs {\"type\": \"dword\"}; STRUCTURE needs a name plus a fields array of {name, type} objects; ARRAY needs count plus either element_type or element_struct; STRING takes an optional type. It must be an OBJECT — a JSON string is rejected.",
          "name": "type_definition",
          "required": true,
          "source": "body",
          "type": "any"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/apply_data_classification",
      "read_only": false
    },
    {
      "category": "datatype",
      "category_description": "Struct/enum/union CRUD, apply data types, type conflicts, validation",
      "description": "Apply data type at address. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Type to apply at the address. Any name the resolver understands: a built-in (uint, char *), an existing struct/enum/typedef name, a pointer chain (int**), or array syntax basetype[count] such as dword[10]. Create the type first with create_struct / create_enum / create_derived_type if it does not exist yet.",
          "name": "type_name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "true",
          "description": "True (the default) clears whatever code or data occupies the FULL target range first, which is what lets you retype an address sitting inside a wider existing unit. False leaves existing units alone, and the write then fails with a conflict if anything overlaps. Clearing is also what arms the guard that refuses a write which would destroy named neighbours.",
          "name": "clear_existing",
          "required": false,
          "source": "body",
          "type": "boolean"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "Optional per-call override for naming enforcement: 'enforce' / 'warn' / 'off'. Omit to use the project/global setting.",
          "name": "strict_mode",
          "required": false,
          "source": "body",
          "type": "string"
        }
      ],
      "path": "/apply_data_type",
      "read_only": false
    },
    {
      "category": "analysis",
      "description": "Apply documentation to ONE function (fields at the top level) OR MANY (entries=[{address, ...}, ...]). Per function, every step is optional and independent and the response reports each one: rename, signature, variable types and renames, comments, labels, then a completeness score. It accepts what get_function_documentation exports (with target_address), so documentation copied between versions applies as it is. The signature is applied before the comments on purpose, because setting a prototype wipes the plate comment.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "aliases": [
            "target_address"
          ],
          "default": "",
          "description": "Function entry address, as 0x<hex> or <space>:<hex> (single mode). Every step is applied to the function at this address. Omit when using entries[].",
          "name": "address",
          "param_type": "address",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "[]",
          "description": "Bulk mode: array of objects, each taking the same fields as the top level (address, name, prototype, ...). When non-empty, the top-level fields are ignored and the response lists one result per entry. One entry failing does not stop the rest.",
          "name": "entries",
          "required": false,
          "source": "body",
          "type": "array"
        },
        {
          "default": "false",
          "description": "True navigates the CodeBrowser to the function before anything else. Needs a window, so it fails on a headless server.",
          "name": "goto",
          "required": false,
          "source": "body",
          "type": "boolean"
        },
        {
          "aliases": [
            "function_name"
          ],
          "default": "",
          "description": "New function name. Omit or leave empty to skip the rename step.",
          "name": "name",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Full C signature. Exclusive with return_type. Applied BEFORE the comment step on purpose.",
          "name": "prototype",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Calling convention, e.g. __stdcall. Goes with the prototype when there is one, and is applied on its own otherwise.",
          "name": "calling_convention",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Return type name, for when there is no prototype. A type that does not resolve is reported, not skipped; undefined* is skipped, as in an export.",
          "name": "return_type",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "aliases": [
            "parameters"
          ],
          "default": "[]",
          "description": "Array of {ordinal, name, type} as get_function_documentation exports them. A generic name (param_N) and an undefined type are skipped, so an export applies back without reverting anything. Reported under variable_renames and variable_types.",
          "name": "params",
          "required": false,
          "source": "body",
          "type": "array"
        },
        {
          "description": "Object mapping a variable's CURRENT name to its new type. Each is applied on its own; the step reports set/failed counts plus per-variable errors.",
          "name": "variable_types",
          "required": true,
          "source": "body",
          "type": "object"
        },
        {
          "description": "Object mapping each variable's CURRENT name to its new name.",
          "name": "variable_renames",
          "required": true,
          "source": "body",
          "type": "object"
        },
        {
          "default": "",
          "description": "Plate comment for the function. Pass real multi-line text: an escaped newline sequence is stored as those two literal characters, not as a line break. Empty is skipped; clear one with set_comment.",
          "name": "plate_comment",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "[]",
          "description": "Array of {address | relative_offset, pre_comment, eol_comment}: PRE (the decompiler's line above) and EOL (the listing's trailing) comments. relative_offset counts from the function entry, as the export writes it. An empty string clears that comment.",
          "name": "comments",
          "required": false,
          "source": "body",
          "type": "array"
        },
        {
          "default": "[]",
          "description": "Array of {address | relative_offset, name}. A label already there with that name is left alone.",
          "name": "labels",
          "required": false,
          "source": "body",
          "type": "array"
        },
        {
          "default": "",
          "description": "Comma-separated function tags to attach (in an entry, a string or an array of names). A tag that does not exist is created. Tags are only added here; remove one with remove_function_tag.",
          "name": "tags",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Object mapping a tag name to its description, used for a tag this call creates; an existing tag keeps its description.",
          "name": "tag_comments",
          "required": true,
          "source": "body",
          "type": "object"
        },
        {
          "default": "",
          "description": "True appends a compact completeness score to each function. Default: true for one function, false for entries[], where it costs a decompile each.",
          "name": "score",
          "required": false,
          "source": "body",
          "type": "boolean"
        },
        {
          "default": "",
          "description": "Target program name or project path. Every step runs against it. Omit to use the active program; always specify it on a headless server or when several programs are open.",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/apply_documentation",
      "read_only": false
    },
    {
      "category": "documentation",
      "category_description": "Function hashing, cross-binary documentation, undocumented function discovery",
      "description": "Ingest a single function's documentation into the cross-version archive (the doc archive service configured via GHIDRA_MCP_ARCHIVE_URL). Idempotent; field-level merge resolution happens on the archive side. Use archive_ingest_program for bulk.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "aliases": [
            "address",
            "name",
            "function_address",
            "function_name"
          ],
          "description": "Function entry-point address (Ghidra hex form)",
          "name": "function",
          "param_type": "function_ref",
          "required": true,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program path/name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "Override the auto-extracted version (e.g. '1.0')",
          "name": "version_override",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "false",
          "description": "Build payload but skip the POST",
          "name": "dry_run",
          "required": false,
          "source": "query",
          "type": "boolean"
        }
      ],
      "path": "/archive_ingest_function",
      "read_only": false
    },
    {
      "category": "documentation",
      "category_description": "Function hashing, cross-binary documentation, undocumented function discovery",
      "description": "Bulk-ingest every function in a program into the cross-version documentation archive. Posts each to /v1/doc_archive/upsert. Returns per-binary counts (created / updated / conflicts_enqueued / errors).",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "default": "",
          "description": "Target program path/name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "Override the auto-extracted version (e.g. '1.0')",
          "name": "version_override",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "0",
          "description": "Stop after N functions (0 = no limit)",
          "name": "limit",
          "required": false,
          "source": "query",
          "type": "integer"
        },
        {
          "default": "true",
          "description": "Skip functions whose name is FUN_/LAB_/etc. (default-named)",
          "name": "skip_default_named",
          "required": false,
          "source": "query",
          "type": "boolean"
        },
        {
          "default": "false",
          "description": "Build all payloads but skip the POSTs",
          "name": "dry_run",
          "required": false,
          "source": "query",
          "type": "boolean"
        }
      ],
      "path": "/archive_ingest_program",
      "read_only": false
    },
    {
      "category": "project",
      "description": "Archive the currently open project to a Ghidra-native .gar file. The result can be restored into any Ghidra GUI via File → Restore Project, or back into a headless instance via /restore_project. Captures the entire project (all programs, folders, settings, version-control metadata) — unlike /export_program which ships a single program as .gzf. Output is written to `output_dir/output_name` (defaults: /data/exports and `<project>.gar`). Refuses to overwrite an existing file, and refuses while an open program has unsaved changes, since the archive would not contain them: save first.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "default": "/data/exports",
          "description": "Directory the .gar will be written to. Must already exist.",
          "name": "output_dir",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Output file name. Defaults to `<project>.gar`. `.gar` is appended if missing.",
          "name": "output_name",
          "required": false,
          "source": "body",
          "type": "string"
        }
      ],
      "path": "/archive_project",
      "read_only": false
    },
    {
      "category": "datatype",
      "category_description": "Struct/enum/union CRUD, apply data types, type conflicts, validation",
      "description": "Audit a global variable's documentation state. Returns name, type, length, plate comment, xref count, and list of issues. Use this before set_global so you know exactly what's missing.",
      "destructive": false,
      "method": "GET",
      "params": [
        {
          "description": "Address of the global. Accepts 0x<hex> (default space) or <space>:<hex>.",
          "name": "address",
          "param_type": "address",
          "required": true,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/audit_global",
      "read_only": true
    },
    {
      "category": "datatype",
      "category_description": "Struct/enum/union CRUD, apply data types, type conflicts, validation",
      "description": "Audit every global variable referenced from within a function in one call. Walks the function's instructions, collects unique data references, and returns the per-global audit (same shape as audit_global) plus a summary of how many are fully documented vs have issues. The killer per-function pre-flight tool — start every doc pass with this when the function has global xrefs.",
      "destructive": false,
      "method": "GET",
      "params": [
        {
          "aliases": [
            "address",
            "name",
            "function_address",
            "function_name"
          ],
          "description": "Address of the function (NOT a global address). Accepts 0x<hex> (default space) or <space>:<hex>.",
          "name": "function",
          "param_type": "function_ref",
          "required": true,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/audit_globals_in_function",
      "read_only": true
    },
    {
      "category": "function",
      "category_description": "Decompile, rename, prototype, variables, batch rename, create/delete functions",
      "description": "Rename function and components atomically. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "aliases": [
            "address",
            "function_address"
          ],
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "function",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Optional new name for the function; leave empty to keep the current one. Unlike rename_function this writes the name directly and does NOT run the naming-quality gate.",
          "name": "function_name",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "description": "JSON object mapping each parameter's CURRENT name to its new name. Keys must match exactly; an entry naming a parameter that does not exist is ignored silently, and parameters_renamed in the response reports how many actually landed.",
          "name": "parameter_renames",
          "required": true,
          "source": "body",
          "type": "object"
        },
        {
          "description": "JSON object mapping each local variable's CURRENT name to its new name, same rules as parameter_renames; locals_renamed reports how many landed.",
          "name": "local_renames",
          "required": true,
          "source": "body",
          "type": "object"
        },
        {
          "default": "",
          "description": "Optional new return type: a type name, a pointer (char*) or an array (int[4]), resolved like every other tool's type argument. A type that cannot be resolved refuses the whole call before anything is renamed.",
          "name": "return_type",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/batch_rename_function_components",
      "read_only": false
    },
    {
      "category": "comment",
      "category_description": "Set/get plate, decompiler, disassembly, repeatable comments",
      "description": "Set multiple comments in one operation. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "[]",
          "description": "JSON array of {address, comment} objects setting PRE comments — the lines the decompiler shows above a statement. Every entry carries its OWN address (0x<hex> or <space>:<hex>); the top-level `address` is the function entry and is not used for these. An entry missing either key, or whose address does not parse, is skipped silently — compare decompiler_comments_set against what you sent. An empty comment string clears that address's PRE comment.",
          "name": "decompiler_comments",
          "required": false,
          "source": "body",
          "type": "array"
        },
        {
          "default": "[]",
          "description": "JSON array of {address, comment} objects setting EOL comments — the trailing comment on a listing line. Same per-entry address rules and the same silent skip as decompiler_comments; an empty comment string clears that address's EOL comment.",
          "name": "disassembly_comments",
          "required": false,
          "source": "body",
          "type": "array"
        },
        {
          "default": "null",
          "description": "Plate comment text. Omit to leave existing plate untouched. Pass empty string to explicitly clear.",
          "name": "plate_comment",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/batch_set_comments",
      "read_only": false
    },
    {
      "category": "documentation",
      "category_description": "Function hashing, cross-binary documentation, undocumented function discovery",
      "description": "Report of source file strings and their FUN_* functions",
      "destructive": false,
      "method": "GET",
      "params": [
        {
          "default": ".cpp",
          "description": "File pattern (e.g. .cpp)",
          "name": "pattern",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/batch_string_anchor_report",
      "read_only": true
    },
    {
      "category": "documentation",
      "category_description": "Function hashing, cross-binary documentation, undocumented function discovery",
      "description": "Bulk cross-binary function matching",
      "destructive": false,
      "method": "GET",
      "params": [
        {
          "description": "Source program name",
          "name": "source_program",
          "required": true,
          "source": "query",
          "type": "string"
        },
        {
          "description": "Target program name",
          "name": "target_program",
          "required": true,
          "source": "query",
          "type": "string"
        },
        {
          "default": "0.7",
          "description": "Similarity threshold",
          "name": "threshold",
          "required": false,
          "source": "query",
          "type": "number"
        },
        {
          "default": "0",
          "description": "Number of SOURCE functions to skip before this page starts; 0 begins at the first. Negative values are clamped to 0, and an offset past the end returns an empty match list.",
          "name": "offset",
          "required": false,
          "source": "query",
          "type": "integer"
        },
        {
          "default": "50",
          "description": "How many SOURCE functions this page tries to match (default 50) — it slices the source list, not the matches. 0 returns an EMPTY page; total_source_functions reports the full count to page against.",
          "name": "limit",
          "required": false,
          "source": "query",
          "type": "integer"
        },
        {
          "description": "Name filter",
          "name": "filter",
          "required": true,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/bulk_fuzzy_match",
      "read_only": true
    },
    {
      "category": "symbol",
      "category_description": "Create/rename/delete labels, rename data, globals, external locations",
      "description": "Check if address supports rename. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "destructive": false,
      "method": "GET",
      "params": [
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "address",
          "param_type": "address",
          "required": true,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/can_rename_at_address",
      "read_only": true
    },
    {
      "category": "utility",
      "description": "Liveness probe: {status, server_kind (gui/headless), version, program when one is current}. Cheap and\n token-less, unlike the fuller /mcp/health; both servers answer it identically.",
      "destructive": false,
      "method": "GET",
      "params": [],
      "path": "/check_connection",
      "read_only": true
    },
    {
      "category": "server",
      "description": "Check a program in to the shared Ghidra Server as a new version. Saves pending edits and closes the program first (a file checked in while open must stay checked out). Requires a shared project and the file checked out. Returns version_before/version/version_bumped. dry_run=true checks everything and reports what would happen (programs it would save, whether it would close one) without doing any of it.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "default": "",
          "description": "Project path of the file; empty uses the sole open program",
          "name": "path",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Check-in comment recorded on the new version",
          "name": "comment",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "false",
          "description": "Keep the file checked out after the new version lands, so you can keep editing. False (the default) releases the checkout.",
          "name": "keep_checked_out",
          "required": false,
          "source": "body",
          "type": "boolean"
        },
        {
          "default": "false",
          "description": "Report what the check-in would do without saving, closing or checking in anything.",
          "name": "dry_run",
          "required": false,
          "source": "body",
          "type": "boolean"
        }
      ],
      "path": "/checkin_program",
      "read_only": false
    },
    {
      "category": "function",
      "category_description": "Decompile, rename, prototype, variables, batch rename, create/delete functions",
      "description": "Run Ghidra's GUI 'Clear Flow and Repair' action on a seed range: clears instruction flow reachable from the seed, then repairs function bodies and re-disassembles retained flow (ClearFlowAndRepairCmd with clear_data=false, clear_labels=false, repair=true). Use to rebuild regions whose flow was created under wrong assumptions, e.g. a function truncated while a callee was incorrectly marked non-returning. The command follows control flow BEYOND the seed range; the reported observations are seed-local only and do not describe everything the command changed. The flow traversal is not cancellable — a very large connected flow can hold the write lock (GUI: the Swing thread) until it completes. Ghidra treats a seed with exactly one candidate flow start (an instruction that is neither a function entry nor reached by fallthrough from inside the seed) as the flow being intentionally removed and does not reseed that start during repair; consequently, applying this action to otherwise healthy flow can clear code, matching the GUI action's behavior. The response's seed_range.end_address_exclusive is null when the seed ends at its address space's maximum address, since that boundary has no representable exclusive successor. Results are reachability-dependent and the command is not idempotent: some damaged regions may require more than one application to rebuild, while applying it again to healthy flow can clear code — inspect the before/after observations and resulting disassembly after every call.",
      "destructive": true,
      "method": "POST",
      "params": [
        {
          "description": "Seed start. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000). Use get_address_spaces first on multi-space programs.",
          "name": "start_address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Exclusive seed end (consistent with disassemble_bytes). Must be in the same address space as start_address and strictly greater. Omitted: one-address seed; the command still follows flow from there like clicking one address in the GUI.",
          "name": "end_address",
          "param_type": "address",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/clear_flow_and_repair",
      "read_only": false
    },
    {
      "category": "comment",
      "category_description": "Set/get plate, decompiler, disassembly, repeatable comments",
      "description": "Clear all comments within a function. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "destructive": true,
      "method": "POST",
      "params": [
        {
          "aliases": [
            "address",
            "name",
            "function_address",
            "function_name"
          ],
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "function",
          "param_type": "function_ref",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "true",
          "description": "True (the default) removes the function's plate comment — the block above its entry. False leaves it alone.",
          "name": "clear_plate",
          "required": false,
          "source": "body",
          "type": "boolean"
        },
        {
          "default": "true",
          "description": "True (the default) removes every PRE (decompiler) comment inside the function body. False leaves them alone.",
          "name": "clear_pre",
          "required": false,
          "source": "body",
          "type": "boolean"
        },
        {
          "default": "true",
          "description": "True (the default) removes every EOL (disassembly) comment inside the function body. False leaves them alone.",
          "name": "clear_eol",
          "required": false,
          "source": "body",
          "type": "boolean"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/clear_function_comments",
      "read_only": false
    },
    {
      "category": "function",
      "category_description": "Decompile, rename, prototype, variables, batch rename, create/delete functions",
      "description": "Clear flow override at address. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "destructive": true,
      "method": "POST",
      "params": [
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/clear_instruction_flow_override",
      "read_only": false
    },
    {
      "category": "datatype",
