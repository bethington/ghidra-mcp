      "params": [
        {
          "description": "Regex search pattern",
          "name": "search_term",
          "required": true,
          "source": "query",
          "type": "string"
        },
        {
          "default": "4",
          "description": "Ignore strings shorter than this many CHARACTERS of decoded text (not bytes on disk). Default 4 drops one- to three-character fragments.",
          "name": "min_length",
          "required": false,
          "source": "query",
          "type": "integer"
        },
        {
          "default": "",
          "description": "Label echoed back in each match's `encoding` field. It does NOT filter: every defined string is searched whatever you pass here, and matches that carry no value report the literal string `ascii`.",
          "name": "encoding",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "0",
          "description": "Number of matches to skip before this page starts; 0 begins at the first match. Applied after the regex and min_length filters.",
