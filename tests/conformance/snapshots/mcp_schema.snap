      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Script to run. Searched in ~/ghidra_scripts, <cwd>/ghidra_scripts and ./ghidra_scripts, then tried as an absolute path. A name with no dot in it is tried with .java, then .py, then bare.",
          "name": "script_name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Arguments handed to the script, split on WHITESPACE into a String[]. There is no quoting, so an argument containing a space arrives as two arguments.",
          "name": "args",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "300",
          "description": "Wall-clock limit for the run in SECONDS: 1 to 1800, default 300. A value outside that range is REJECTED, not clamped.",
          "name": "timeout_seconds",
          "required": false,
          "source": "body",
          "type": "integer"
        },
        {
          "default": "true",
          "description": "Return the script's console output in the response. Set false for scripts that emit large volumes of console text you do not need -- the script still runs and 'success' is still reported, but 'console_output' is omitted and 'output_captured' is false. Output of a FAILED script is always returned regardless, so a failure is never silent.",
          "name": "capture_output",
          "required": false,
          "source": "body",
          "type": "boolean"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/run_ghidra_script",
