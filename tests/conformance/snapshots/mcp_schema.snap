          "name": "filter",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "all",
          "description": "Type-assignment axis: `all` (default), `defined` (only items with a real type), `undefined` (only items with no defined type or `undefined*` types).",
