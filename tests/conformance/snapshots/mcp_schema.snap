    {
      "category": "analysis",
      "category_description": "Completeness analysis, control flow, similarity, crypto detection, memory inspection",
      "description": "Search for instructions by mnemonic and/or operand substring. Complement to /search_byte_patterns (byte-level); this matches after Ghidra has parsed instructions, so you can search for 'mov' + '[ecx+0xD0]' without knowing the encoding. Case-insensitive substring match on both fields. Returns {address, function, mnemonic, operands, bytes} per match.",
      "method": "GET",
      "params": [
        {
          "default": "",
          "description": "Case-insensitive mnemonic match (exact, not substring — 'mov' matches 'MOV' but not 'movsd'). Omit to match any mnemonic.",
          "name": "mnemonic",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "Case-insensitive substring matched against the joined operand string (e.g. '[ecx+0xd0]', 'eax', '0x10001000'). Omit to match any operand.",
          "name": "operand_pattern",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "Restrict search to this function (by name or entry-point address). Omit to search the whole program.",
          "name": "function",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "500",
          "description": "Maximum matches returned. Walking stops as soon as the cap is hit.",
          "name": "limit",
          "required": false,
          "source": "query",
          "type": "integer"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open).",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/search_instructions"
    },
    {
      "category": "listing",
      "category_description": "Enumerate functions, strings, segments, imports, exports, namespaces, classes, data items",
      "description": "Search strings by regex pattern.",
      "method": "GET",
      "params": [
        {
          "description": "Regex search pattern",
          "name": "search_term",
          "required": true,
          "source": "query",
          "type": "string"
        },
        {
          "default": "4",
          "description": "Ignore strings shorter than this many CHARACTERS of decoded text (not bytes on disk). Default 4 drops one- to three-character fragments.",
          "name": "min_length",
          "required": false,
          "source": "query",
          "type": "integer"
        },
        {
          "default": "",
          "description": "Label echoed back in each match's `encoding` field. It does NOT filter: every defined string is searched whatever you pass here, and matches that carry no value report the literal string `ascii`.",
          "name": "encoding",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "0",
          "description": "Number of matches to skip before this page starts; 0 begins at the first match. Applied after the regex and min_length filters.",
          "name": "offset",
          "required": false,
          "source": "query",
          "type": "integer"
        },
        {
          "default": "100",
          "description": "Maximum matches returned in this page (default 100). `total` in the response reports how many matched before paging. Unlike the paged list endpoints, 0 here returns an EMPTY page rather than everything.",
          "name": "limit",
          "required": false,
          "source": "query",
          "type": "integer"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/search_strings"
    },
    {
      "category": "server",
