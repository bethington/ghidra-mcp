          "name": "name_pattern",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "false",
          "description": "Treat name_pattern as a regular expression.",
          "name": "regex",
          "required": false,
          "source": "query",
          "type": "boolean"
        },
        {
          "default": "",
          "description": "Only functions with at least this many references to them.",
          "name": "min_xrefs",
          "required": false,
          "source": "query",
          "type": "integer"
        },
        {
          "default": "",
          "description": "Only functions with at most this many references to them.",
          "name": "max_xrefs",
          "required": false,
          "source": "query",
          "type": "integer"
        },
        {
          "default": "",
          "description": "Only functions with this calling convention (e.g. __stdcall).",
          "name": "calling_convention",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "true = only functions somebody has named; false = only auto-generated names (FUN_*, thunk_*).",
          "name": "has_custom_name",
          "required": false,
          "source": "query",
          "type": "boolean"
        },
        {
          "default": "",
          "description": "true = only thunks, false = exclude them, omit for both.",
          "name": "is_thunk",
          "required": false,
          "source": "query",
          "type": "boolean"
        },
        {
          "default": "",
          "description": "true = only external functions, false = exclude them.",
