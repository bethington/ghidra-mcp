          "type": "string"
        }
      ],
      "path": "/list_project_files"
    },
    {
      "category": "program",
      "category_description": "Program management, script execution, memory read, bookmarks, save",
      "description": "List (address, value) entries stored in a property map, with pagination. Optionally restrict to an inclusive address range with start/end.",
      "method": "GET",
      "params": [
        {
          "description": "Property map name (from list_property_maps).",
          "name": "map",
          "required": true,
