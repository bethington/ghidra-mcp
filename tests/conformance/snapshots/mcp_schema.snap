          "source": "body",
          "type": "string"
        },
        {
          "description": "Server user whose access is being set. The repository ACL is read, this one entry replaced or appended, and every other user preserved.",
          "name": "user",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Numeric Ghidra access level: 0 no access, 1 read only, 2 read/write, 3 admin. Defaults to 1.",
          "name": "accessLevel",
          "required": false,
          "source": "body",
          "type": "string"
        }
      ],
      "path": "/server/admin/set_permissions"
    },
    {
      "category": "server",
      "description": "Terminate all checkouts in a folder recursively",
      "method": "POST",
      "params": [
        {
          "description": "Repository name on the Ghidra Server. Read only by the headless server — the GUI plugin works on the already-open project and ignores it.",
          "name": "repo",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Folder to walk recursively, terminating every checkout under it. Defaults to / — the whole repository or project.",
          "name": "path",
