          "source": "body",
          "type": "string"
        }
      ],
      "path": "/server/version_control/add"
    },
    {
      "category": "server",
      "description": "Check in a version-controlled file",
      "method": "POST",
      "params": [
        {
          "description": "Repository name on the Ghidra Server. Read only by the headless server — the GUI plugin works on the already-open project and ignores it.",
          "name": "repo",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Path of the checked-out file to check in.",
          "name": "path",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Check-in comment recorded on the new version. Defaults to a generic Checked in via GhidraMCP.",
          "name": "comment",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "description": "True keeps the file checked out after the version lands, so you can keep editing. False (the default) releases the checkout.",
          "name": "keepCheckedOut",
          "required": false,
          "source": "body",
          "type": "string"
        }
      ],
      "path": "/server/version_control/checkin"
    },
