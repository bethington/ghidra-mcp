    {
      "category": "utility",
      "description": "List all running Ghidra tool windows",
      "method": "GET",
      "params": [],
      "path": "/tool/running_tools"
    },
    {
      "category": "datatype",
      "category_description": "Struct/enum/union CRUD, apply data types, type conflicts, validation",
      "description": "Validate a data type. With an address: checks applicability (memory range, alignment, conflicts) at that address. Without an address: checks only that the type exists, resolving bare names like 'int'/'DWORD'/'char *' across all categories. Replaces validate_data_type_exists.",
      "method": "GET",
      "params": [
        {
          "default": "",
          "description": "Optional address. Omit to check type existence only; provide to validate applicability at that address (memory range/alignment/conflicts). Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00).",
          "name": "address",
          "param_type": "address",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "description": "Data type name (bare names resolve across all categories)",
          "name": "type_name",
          "required": true,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/validate_data_type"
    },
    {
      "category": "datatype",
      "category_description": "Struct/enum/union CRUD, apply data types, type conflicts, validation",
      "description": "Validate prototype before applying. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "method": "GET",
      "params": [
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "function_address",
          "param_type": "address",
          "required": true,
          "source": "query",
          "type": "string"
        },
        {
          "description": "Function prototype",
          "name": "prototype",
          "required": true,
          "source": "query",
          "type": "string"
        },
        {
          "description": "Calling convention",
          "name": "calling_convention",
          "required": true,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/validate_function_prototype"
