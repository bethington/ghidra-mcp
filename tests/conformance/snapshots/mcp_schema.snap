      "description": "Grow or shrink an existing structure by total byte size. Defined fields whose end offset fits within new_size are preserved; growth pads with undefined filler. Refuses shrink that would clip defined fields unless force=true. See docs/STRUCT_RESIZE_WORKFLOW.md.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Simple name of the existing structure to resize, matched across every category (no /path prefix needed).",
          "name": "name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "New TOTAL size of the struct in bytes, not a field count. Must be positive. Growing pads with undefined filler; shrinking past a defined field is refused unless force=true.",
          "name": "new_size",
          "required": true,
          "source": "body",
          "type": "integer"
        },
        {
          "default": "true",
          "description": "When true (default), keep defined fields that still fit; when false with force, trailing layout may be cleared before resize.",
