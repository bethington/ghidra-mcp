{
  "count": 239,
  "tools": [
    {
      "category": "function",
      "category_description": "Decompile, rename, prototype, variables, batch rename, create/delete functions",
      "description": "Attach tags to ONE function (function + tags) OR MANY in one transaction (assignments=[{function,tags}, ...]). Tags are comma-separated and auto-created. Replaces batch_add_function_tags.",
      "method": "POST",
      "params": [
        {
          "default": "",
          "description": "Function address or name (single mode). Omit when using assignments[].",
          "name": "function",
          "param_type": "address",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Comma-separated tag names to attach (single mode).",
          "name": "tags",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "[]",
          "description": "Bulk mode: array of {function, tags} objects. When non-empty, function/tags are ignored.",
          "name": "assignments",
          "required": false,
          "source": "body",
          "type": "array"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/add_function_tag"
    },
    {
      "category": "xref",
      "category_description": "Cross-references, call graphs, incoming/outgoing calls, data refs",
      "description": "Create a cross-reference between two memory addresses that the auto-analyzer can't infer (runtime-populated pointer tables, vtables, late-bound function pointers, missed jump/switch tables). Leaves the underlying bytes untouched and adds proper bidirectional navigation. On programs with multiple address spaces (e.g. embedded targets), prefix addresses with the space name (mem:1000).",
      "method": "POST",
      "params": [
        {
          "description": "Source address the reference originates from (the table slot / instruction). Accepts 0x<hex> or <space>:<hex> (e.g. mem:1000).",
          "name": "from_address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Target address the reference points to. Accepts 0x<hex> or <space>:<hex>.",
          "name": "to_address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "DATA",
          "description": "Reference type (case-insensitive RefType name): DATA, READ, WRITE, READ_WRITE, COMPUTED_CALL, UNCONDITIONAL_CALL, COMPUTED_JUMP, UNCONDITIONAL_JUMP, CONDITIONAL_JUMP, INDIRECTION, etc.",
          "name": "ref_type",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "USER_DEFINED",
          "description": "SourceType: USER_DEFINED (default — distinct from analyzer refs and survives re-analysis), ANALYSIS, IMPORTED, DEFAULT.",
          "name": "source_type",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "-1",
          "description": "Operand index the reference attaches to. -1 = mnemonic/data operand.",
          "name": "operand_index",
          "required": false,
          "source": "body",
          "type": "integer"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/add_memory_reference"
    },
    {
      "category": "datatype",
      "category_description": "Struct/enum/union CRUD, apply data types, type conflicts, validation",
      "description": "Add a field to a structure",
      "method": "POST",
      "params": [
        {
          "description": "Simple name of the existing structure to add to, matched across every category (no /path prefix needed).",
          "name": "struct_name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Name for the new field. The project's Hungarian prefix is applied automatically from field_type, so the stored name can differ from what you send — the response reports the name actually used, and remove_struct_field accepts either form.",
          "name": "field_name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Type of the new field, resolved recursively (pointer chains, array syntax such as dword[8], existing struct/enum names).",
          "name": "field_type",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "-1",
          "description": "BYTE offset to place the field at. -1 (the default) appends to the end. A non-negative offset OVERWRITES whatever occupies that range rather than shifting later fields, and grows the struct when it lies at or past the current end.",
          "name": "offset",
          "required": false,
          "source": "body",
          "type": "integer"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/add_struct_field"
    },
    {
      "category": "program",
      "category_description": "Program management, script execution, memory read, bookmarks, save",
      "description": "Get auto-analysis status for open programs",
      "method": "GET",
      "params": [
        {
          "description": "Program name (omit for all open programs)",
          "name": "program",
          "required": true,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/analysis_status"
    },
