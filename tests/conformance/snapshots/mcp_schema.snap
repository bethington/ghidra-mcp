    {
      "category": "program",
      "category_description": "Program management, script execution, memory read, bookmarks, save",
      "description": "List (address, value) entries stored in a property map, with pagination. Optionally restrict to an inclusive address range with start/end. Omit map to list the property maps instead: each one's name, value type (int|long|string|object|void) and how many addresses hold a value.",
      "destructive": false,
      "method": "GET",
      "params": [
        {
          "description": "Property map name (list them with list_properties and no map).",
          "name": "map",
          "required": true,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "Optional inclusive start address of a range filter.",
          "name": "start",
          "param_type": "address",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "Optional inclusive end address of a range filter (requires start).",
          "name": "end",
          "param_type": "address",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "0",
          "description": "Number of entries to skip.",
          "name": "offset",
          "required": false,
          "source": "query",
          "type": "integer"
        },
        {
          "default": "100",
          "description": "Maximum number of entries to return.",
          "name": "limit",
          "required": false,
          "source": "query",
          "type": "integer"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/list_properties",
      "read_only": true
    },
    {
      "category": "program",
      "category_description": "Program management, script execution, memory read, bookmarks, save",
      "description": "List available Ghidra scripts",
      "destructive": false,
      "method": "GET",
      "params": [
        {
          "default": "",
          "description": "Script name filter",
          "name": "filter",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/list_scripts",
      "read_only": true
    },
    {
      "category": "listing",
      "category_description": "Enumerate functions, strings, segments, imports, exports, namespaces, classes, data items",
      "description": "List named global DATA symbols that have NO type of their own because a larger data unit starting at an earlier address covers them. These are invisible to /list_globals — it resolves the CONTAINING unit, so it reports the covering neighbour's type at the shadowed address and the global looks perfectly typed. Each record carries the container that swallowed it. Use this to find documentation that a neighbouring type application destroyed, or a symbol sitting inside an array where it does not belong.",
      "destructive": false,
      "method": "GET",
      "params": [
        {
          "default": "0",
          "description": "Number of entries to skip before this page starts; 0 begins at the first entry. Page by adding `limit` each call until offset reaches the `total` the response reports.",
          "name": "offset",
          "required": false,
          "source": "query",
          "type": "integer"
        },
        {
          "default": "500",
          "description": "Maximum entries returned in this page (default 500). Pass 0 or a negative value for no limit; `total` in the response always reports the full unpaged count.",
          "name": "limit",
          "required": false,
          "source": "query",
          "type": "integer"
        },
        {
          "default": "false",
          "description": "By default only data sections are scanned, matching list_globals.",
          "name": "include_all_sections",
          "required": false,
          "source": "query",
          "type": "boolean"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/list_shadowed_globals",
      "read_only": true
    },
    {
      "category": "listing",
      "category_description": "Enumerate functions, strings, segments, imports, exports, namespaces, classes, data items",
      "description": "List defined strings with optional filter",
      "destructive": false,
      "method": "GET",
      "params": [
        {
          "default": "0",
          "description": "Number of entries to skip before this page starts; 0 begins at the first entry. Page by adding `limit` each call until offset reaches the `total` the response reports.",
          "name": "offset",
          "required": false,
          "source": "query",
          "type": "integer"
        },
        {
          "default": "100",
          "description": "Maximum entries returned in this page (default 100). Pass 0 or a negative value for no limit; `total` in the response always reports the full unpaged count.",
          "name": "limit",
          "required": false,
          "source": "query",
          "type": "integer"
        },
        {
          "default": "",
          "description": "Substring filter",
          "name": "filter",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/list_strings",
      "read_only": true
    },
    {
      "category": "utility",
      "description": "Server health: kind (gui/headless), build, current program, uptime, HTTP pool, memory, endpoint count",
      "destructive": false,
      "method": "GET",
      "params": [],
      "path": "/mcp/health",
      "read_only": true
    },
    {
      "category": "utility",
      "description": "Machine-readable API schema with endpoint metadata",
      "destructive": false,
      "method": "GET",
      "params": [],
      "path": "/mcp/schema",
      "read_only": true
    },
    {
      "category": "documentation",
      "category_description": "Function hashing, cross-binary documentation, undocumented function discovery",
      "description": "Bulk merge: copy ALL RE documentation from one program to another at matching addresses, in a single server-side transaction. Categories: function names + signatures + plate comments + locals + calling convention + no-return + tags; standalone data types; data definitions (typed globals); plate comments at any address; comments at all 4 types (EOL/PRE/POST/REPEATABLE) on instructions AND data; labels & globals (with namespace preservation); external locations (ordinal renames); bookmarks; equates. Designed for the orphan-rescue workflow: source is typically '<name>_recovered', target is the original '<name>.dll'. Idempotent — re-running on an already-merged target only fills gaps. Set dry_run=true to count without writing.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Source program path or name (read-only — the rescued copy)",
          "name": "source",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Target program path or name (writes go here — the original .dll)",
          "name": "target",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "false",
          "description": "If true, count what would be merged without writing",
          "name": "dry_run",
          "required": false,
          "source": "body",
          "type": "boolean"
        }
      ],
      "path": "/merge_program_documentation",
      "read_only": false
    },
    {
      "category": "datatype",
      "category_description": "Struct/enum/union CRUD, apply data types, type conflicts, validation",
      "description": "Modify a field in a structure: retype it (new_type, which also embeds a struct by value, e.g. Rectangle inside LayoutNode), rename it (new_name), or both. Fields can be identified by name or by offset (for unnamed fields). For layout size changes (grow/shrink padding), use resize_struct instead of manual delete+create.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Simple name of the existing structure to edit, matched across every category (no /path prefix needed).",
          "name": "struct_name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Field name to modify. For unnamed fields, use 'offset:N' (e.g., 'offset:16') to identify by byte offset.",
          "name": "field_name",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Replacement type for the field, resolved recursively (pointer chains, array syntax, struct names). Leave empty to keep the current type and only rename.",
          "name": "new_type",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Replacement field name. Leave empty to keep the current name and only retype. The project's Hungarian prefix is applied automatically from the field's type, so the stored name can differ from what you send.",
          "name": "new_name",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/modify_struct_field",
      "read_only": false
    },
    {
      "category": "datatype",
      "category_description": "Struct/enum/union CRUD, apply data types, type conflicts, validation",
      "description": "Move data type to category",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Simple name of the type to move, matched across every category (no /path prefix needed).",
          "name": "type_name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Destination category as a /-separated path, e.g. /MyTypes/Network. It is created, with any missing parents, if it does not exist.",
          "name": "category_path",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/move_data_type_to_category",
      "read_only": false
    },
    {
      "category": "project",
      "category_description": "Program management, script execution, memory read, bookmarks, save",
      "description": "Move a program file to a different folder in the project, preserving all analysis and documentation. Refuses when the program has unsaved changes -- call save_program first -- rather than discarding them. A program that is open but clean is closed, moved, then reopened at its new path.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Project file path to move, e.g. /Project/1.0/example.dll",
          "name": "filePath",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Destination project folder path, e.g. /Project/1.1",
          "name": "destFolder",
          "required": true,
          "source": "body",
          "type": "string"
        }
      ],
      "path": "/move_file",
      "read_only": false
    },
    {
      "category": "project",
      "category_description": "Program management, script execution, memory read, bookmarks, save",
      "description": "Move a project folder (and everything under it) into another folder. Refuses to move a folder into itself or into its own descendant, which would orphan the subtree.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Project folder path to move, e.g. /Project/1.0",
          "name": "sourcePath",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Destination parent folder path, e.g. /Archive",
          "name": "destPath",
          "required": true,
          "source": "body",
          "type": "string"
        }
      ],
      "path": "/move_folder",
      "read_only": false
    },
    {
      "category": "program",
      "category_description": "Program management, script execution, memory read, bookmarks, save",
      "description": "Open a program from the open project (by project path, or by filename when unique) and keep it open. On the GUI it is also shown in a CodeBrowser. Any endpoint's program= opens on demand too; this is for opening deliberately, analysing on open, or getting diagnostics when a file cannot be opened (the paths the project does contain, and whether it is bound to a Ghidra Server).",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Program path in the project, or a unique filename",
          "name": "path",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "false",
          "description": "Run auto-analysis after opening",
          "name": "auto_analyze",
          "required": false,
          "source": "body",
          "type": "boolean"
        }
      ],
      "path": "/open_program",
      "read_only": false
    },
    {
      "category": "headless",
      "category_description": "Headless server program management (no GUI required)",
      "description": "Open a Ghidra project: a local .gpr/directory, or a shared Ghidra Server repository via ghidra://host[:port]/repo (creates a persistent local shared project under ~/.ghidra-mcp/shared-projects/ keyed by host_port_repo, overridable with GHIDRA_MCP_SHARED_PROJECT_DIR). Does not auto-open repository files — max ~5 shared-server programs open at once; opening 20+ crashes Ghidra. Requires /server/connect first for URL opens. The local tree mirrors YOUR working copy (not other users' checkins until you refresh).",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Path to an existing project: either its .gpr file, the project directory holding it, or a ghidra://host[:port]/repo URL for a shared Ghidra Server repository.",
          "name": "path",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "GUI mode only. True (the default) loads the project into the FrontEnd tool without opening a CodeBrowser window; false launches one for `program`. The headless server ignores it.",
          "name": "headless",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "description": "GUI mode only, and only when headless=false: the DomainFile path to open in the launched CodeBrowser.",
          "name": "program",
          "required": false,
          "source": "body",
          "type": "string"
        }
      ],
      "path": "/open_project",
      "read_only": false
    },
    {
      "category": "system",
      "description": "Temporarily enable, disable, or query scoped automation prompt handling",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "default": "status",
          "description": "One of: enable, disable, status",
          "name": "action",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "automation",
          "description": "Short reason recorded in prompt-policy logs",
          "name": "reason",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "120",
          "description": "How long to keep the prompt policy active",
          "name": "seconds",
          "required": false,
          "source": "body",
          "type": "integer"
        }
      ],
      "path": "/prompt_policy",
      "read_only": false
    },
    {
      "category": "program",
      "category_description": "Program management, script execution, memory read, bookmarks, save",
      "description": "Read raw memory bytes. Always pass the 'program' argument to target the correct binary — especially when multiple programs are open. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "destructive": false,
      "method": "GET",
      "params": [
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "address",
          "param_type": "address",
          "required": true,
          "source": "query",
          "type": "string"
        },
        {
          "default": "16",
          "description": "Number of bytes",
          "name": "length",
          "required": false,
          "source": "query",
          "type": "integer"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/read_memory",
      "read_only": true
    },
    {
      "category": "program",
      "category_description": "Program management, script execution, memory read, bookmarks, save",
      "description": "Trigger full auto-analysis on a program",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "default": "",
          "description": "Program name (default: current program)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/reanalyze",
      "read_only": false
    },
    {
      "category": "datatype",
      "category_description": "Struct/enum/union CRUD, apply data types, type conflicts, validation",
      "description": "Replace a structure in one step: optionally remove an existing same-named type, then create with fields JSON (same shape as create_struct). Use when resize_struct cannot apply or you are rebuilding layout from get_struct_layout export. Set force=true to delete a non-stub type that is not referenced.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "description": "Name of the structure to (re)create. An existing same-named type is deleted first, but only when replace_placeholder or force allows it.",
          "name": "name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "JSON array of field objects, exactly the shape create_struct takes: required keys name and type, optional offset as a decimal BYTE offset. field_name/fieldName, field_type/fieldType/data_type/dataType and field_offset/fieldOffset/off are accepted as alternates. Field names get the project's Hungarian prefix applied automatically.",
          "name": "fields",
          "required": true,
          "source": "body",
          "type": "json"
        },
        {
          "default": "0",
          "description": "Optional minimum total size in bytes after create; grows with undefined padding when larger than implied field layout.",
          "name": "size",
          "required": false,
          "source": "body",
          "type": "integer"
        },
        {
          "default": "true",
          "description": "Delete a 1-byte placeholder/Demangler stub before recreate (default true).",
          "name": "replace_placeholder",
          "required": false,
          "source": "body",
          "type": "boolean"
        },
        {
          "default": "false",
          "description": "Delete an existing full-sized struct before recreate (fails if referenced).",
          "name": "force",
          "required": false,
          "source": "body",
          "type": "boolean"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/recreate_struct",
      "read_only": false
    },
    {
      "category": "function",
      "category_description": "Decompile, rename, prototype, variables, batch rename, create/delete functions",
      "description": "Detach tags from ONE function (function + tags) OR MANY in one transaction (assignments=[{function,tags}, ...]). Does not delete the program-wide tag definition — use delete_function_tag for that. Replaces batch_remove_function_tags.",
      "destructive": true,
      "method": "POST",
      "params": [
        {
          "aliases": [
            "address",
            "name",
            "function_address",
            "function_name"
          ],
          "default": "",
          "description": "Function address or name (single mode). Omit when using assignments[].",
          "name": "function",
          "param_type": "function_ref",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Comma-separated tag names to detach (single mode).",
          "name": "tags",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "[]",
          "description": "Bulk mode: array of {function, tags} objects. When non-empty, function/tags are ignored.",
          "name": "assignments",
          "required": false,
          "source": "body",
          "type": "array"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/remove_function_tag",
      "read_only": false
    },
    {
      "category": "program",
      "category_description": "Program management, script execution, memory read, bookmarks, save",
      "description": "Remove an option from a program option group. Built-in registered options may be re-created with defaults by Ghidra; primarily for clearing custom options. Call save_program to persist.",
      "destructive": true,
      "method": "POST",
      "params": [
        {
          "description": "Option group name.",
          "name": "group",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Option name to remove.",
          "name": "name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/remove_program_option",
      "read_only": false
    },
    {
      "category": "program",
      "category_description": "Program management, script execution, memory read, bookmarks, save",
      "description": "Remove the value stored at a single address in a property map. Call save_program to persist.",
      "destructive": true,
      "method": "POST",
      "params": [
        {
          "description": "Property map name.",
          "name": "map",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/remove_property",
      "read_only": false
    },
    {
      "category": "xref",
      "category_description": "Cross-references, call graphs, incoming/outgoing calls, data refs",
      "description": "Remove memory cross-reference(s) from one address to another (the inverse of add_memory_reference). Removes every reference from_address -> to_address regardless of operand by default; pass operand_index >= 0 to remove only the reference on that operand. Removes both user-defined and analyzer-inferred references — the response reports each removed reference's source_type. On multi-space programs, prefix addresses with the space name (mem:1000).",
      "destructive": true,
      "method": "POST",
      "params": [
        {
          "description": "Source address the reference originates from. Accepts 0x<hex> or <space>:<hex>.",
          "name": "from_address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Target address the reference points to. Accepts 0x<hex> or <space>:<hex>.",
          "name": "to_address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "-1",
          "description": "Operand index to match. -1 (default) = remove references on any operand; >= 0 = remove only the reference on that operand.",
          "name": "operand_index",
          "required": false,
          "source": "body",
          "type": "integer"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/remove_reference",
      "read_only": false
    },
    {
      "category": "datatype",
      "category_description": "Struct/enum/union CRUD, apply data types, type conflicts, validation",
      "description": "Remove a field from a structure (by the name you created it with, even after Hungarian auto-prefixing).",
      "destructive": true,
      "method": "POST",
      "params": [
        {
          "description": "Simple name of the existing structure to edit, matched across every category (no /path prefix needed).",
          "name": "struct_name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Field to remove. Matched exactly first, then by Hungarian stem, so the name you originally sent still works after auto-prefixing changed it.",
          "name": "field_name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/remove_struct_field",
