          "name": "args",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Working directory hint for launchers that expose one",
          "name": "cwd",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "60",
          "description": "Maximum seconds to wait for the debugger trace",
          "name": "timeout_seconds",
          "required": false,
          "source": "body",
          "type": "integer"
        },
        {
          "default": "",
          "description": "Program path/name to use for static mapping",
          "name": "program",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Optional launcher title or config name, e.g. dbgeng",
          "name": "offer",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Optional Python executable for Python-backed debugger launchers",
          "name": "python_executable",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Directory containing dbgeng.dll, for the dbgeng launcher. Set this when the Windows Debugger Toolkit is not installed: pybag hard-codes the Windows Kits path and fails to load without it, while Windows itself ships a usable dbgeng.dll in System32.",
          "name": "windbg_dir",
          "required": false,
          "source": "body",
          "type": "string"
        }
      ],
      "path": "/debugger/launch"
    },
    {
      "category": "debugger",
      "category_description": "Live debugging: attach, breakpoints, step, registers, memory. Requires a CodeBrowser with Debugger view open.",
      "description": "List available debugger launch/attach options for the current program",
      "method": "GET",
      "params": [
        {
          "default": "",
          "description": "Program to get offers for",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/debugger/launch_offers"
    },
    {
      "category": "debugger",
      "category_description": "Live debugging: attach, breakpoints, step, registers, memory. Requires a CodeBrowser with Debugger view open.",
      "description": "List all breakpoints in the current trace",
      "method": "GET",
      "params": [],
      "path": "/debugger/list_breakpoints"
    },
    {
      "category": "debugger",
      "category_description": "Live debugging: attach, breakpoints, step, registers, memory. Requires a CodeBrowser with Debugger view open.",
      "description": "List modules (DLLs/EXEs) loaded in the debugged process",
      "method": "GET",
      "params": [],
      "path": "/debugger/modules"
    },
    {
      "category": "debugger",
      "category_description": "Live debugging: attach, breakpoints, step, registers, memory. Requires a CodeBrowser with Debugger view open.",
      "description": "Read memory from the debugged process. Returns hex dump and DWORD interpretation.",
      "method": "GET",
      "params": [
        {
          "description": "Start address to read from",
          "name": "address",
          "param_type": "address",
          "required": true,
          "source": "query",
          "type": "string"
        },
        {
          "default": "64",
          "description": "Number of bytes to read (max 4096)",
          "name": "size",
          "required": false,
          "source": "query",
          "type": "integer"
        }
      ],
      "path": "/debugger/read_memory"
    },
    {
      "category": "debugger",
      "category_description": "Live debugging: attach, breakpoints, step, registers, memory. Requires a CodeBrowser with Debugger view open.",
      "description": "Read CPU registers from the current debug trace snapshot. Shows general-purpose registers (EAX-EDI, EIP, ESP, EFLAGS for x86)",
      "method": "GET",
      "params": [],
      "path": "/debugger/registers"
    },
    {
