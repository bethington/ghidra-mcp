          "type": "string"
        },
        {
          "default": "",
          "name": "category",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "name": "comment",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_bookmark"
    },
    {
      "category": "comment",
      "category_description": "Set/get plate, decompiler, disassembly, repeatable comments",
      "description": "Set a listing comment of a given kind at ANY address (data or code). type = plate|pre|eol|post|repeatable (aliases: decompiler=pre, disassembly=eol). Plate writes surface structural warnings and flush the decompiler cache. Symmetric writer for get_comment; replaces the former set_plate_comment / set_decompiler_comment / set_disassembly_comment.",
      "method": "POST",
      "params": [
        {
          "description": "Address in the program (data or code). 0x<hex> or <space>:<hex>.",
          "name": "address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "name": "comment",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "plate",
          "description": "Comment kind: plate | pre | eol | post | repeatable (default plate)",
          "name": "type",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_comment"
    },
    {
      "category": "function",
      "category_description": "Decompile, rename, prototype, variables, batch rename, create/delete functions",
      "description": "Mark function as no-return. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "method": "POST",
      "params": [
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "function_address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "name": "no_return",
          "required": true,
          "source": "body",
          "type": "boolean"
        },
        {
          "default": "",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_function_no_return"
    },
    {
      "category": "function",
      "category_description": "Decompile, rename, prototype, variables, batch rename, create/delete functions",
      "description": "Set function prototype (return type, parameter types, calling convention) by address. NOTE: the function name in the prototype string is used only for parsing — it does NOT rename the function. To rename, call rename_function separately. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "method": "POST",
      "params": [
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "function_address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "name": "prototype",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "name": "calling_convention",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_function_prototype"
    },
    {
      "category": "function",
      "category_description": "Decompile, rename, prototype, variables, batch rename, create/delete functions",
      "description": "Update the comment/description on an existing program-wide function tag.",
      "method": "POST",
      "params": [
        {
          "description": "Tag name",
          "name": "name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "New comment text (pass an empty string to clear)",
          "name": "comment",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_function_tag_comment"
    },
    {
      "category": "function",
      "category_description": "Decompile, rename, prototype, variables, batch rename, create/delete functions",
      "description": "Type the implicit 'this' of a __thiscall/__fastcall member function by associating the function with its class. Ghidra's auto-'this' (ECX on x86) is an immutable auto-parameter; with auto-storage it derives its type from the function's parent Class namespace, matched by name to a same-named structure. This tool finds/creates a class namespace for the struct and moves the function into it (no custom storage). Pass 'MyClass *' or 'MyClass'; the structure MyClass must already exist (create_struct). On programs with multiple address spaces, prefix function_address with the space name (mem:1000).",
      "method": "POST",
      "params": [
        {
          "description": "Function entry address (0x<hex> or <space>:<hex>).",
          "name": "function_address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Class type for this, e.g. 'MyWidget *' or 'MyWidget'. The base struct name becomes the function's class.",
          "name": "this_type",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_function_this_type"
    },
    {
      "category": "datatype",
      "category_description": "Struct/enum/union CRUD, apply data types, type conflicts, validation",
      "description": "Atomically apply name + type + plate-comment + array length to a global variable. Single-transaction; rejects on validation failure with no partial write. Replaces the 4-tool chain (apply_data_type → rename_data → batch_set_comments → create_label).",
      "method": "POST",
      "params": [
        {
          "description": "Address of the global. Accepts 0x<hex> (default space) or <space>:<hex>.",
          "name": "address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "New name. Must follow g_ + Hungarian + descriptor convention (e.g., g_dwActiveQuestState, g_pUnitList).",
          "name": "name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Ghidra data type to apply (e.g., uint, byte, UnitAny *, char *, MyStruct). Use create_struct/create_array_type first if the type doesn't exist. Pass empty to leave type unchanged.",
          "name": "type_name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "0",
          "description": "If >0, applied as an array of array_length elements of type_name. Required when documenting an array of fixed length (e.g., a 100-entry data table).",
          "name": "array_length",
          "required": false,
          "source": "body",
          "type": "integer"
        },
        {
          "description": "Plate comment for the address. First line must be a meaningful one-line summary (≥4 words). Optional sectioned details (Used by:, Layout:, Source:, Bitfield:) follow when applicable. Pass empty to leave plate comment unchanged.",
          "name": "plate_comment",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "Optional per-call override for naming enforcement: 'enforce' / 'warn' / 'off'. Omit to use the project/global setting.",
          "name": "strict_mode",
          "required": false,
          "source": "body",
          "type": "string"
        }
      ],
      "path": "/set_global"
    },
    {
      "category": "program",
      "category_description": "Program management, script execution, memory read, bookmarks, save",
      "description": "Set the base address of the program (rebases all addresses)",
      "method": "POST",
      "params": [
        {
          "description": "New base address (e.g. 0x08000000)",
          "name": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_image_base"
    },
    {
      "category": "program",
      "category_description": "Program management, script execution, memory read, bookmarks, save",
      "description": "Set a typed program option. If the option already exists its type is reused; otherwise pass type (string|int|long|double|float|boolean). New/custom options are created on demand. Call save_program to persist.",
      "method": "POST",
      "params": [
        {
          "description": "Option group name (e.g. 'Program Information'). Use list_option_groups to discover names.",
          "name": "group",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Option name within the group.",
          "name": "name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "New value as a string; parsed according to the option type.",
          "name": "value",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Value type: string|int|long|double|float|boolean. Optional when the option already exists (its current type is reused); defaults to string for a brand-new option.",
          "name": "type",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_program_option"
    },
    {
      "category": "program",
      "category_description": "Program management, script execution, memory read, bookmarks, save",
      "description": "Set a value at an address in a property map. The value is coerced to the map's type (int/long/string); 'void' maps ignore the value and just tag the address. Create the map first with create_property_map. Call save_program to persist.",
      "method": "POST",
      "params": [
        {
          "description": "Property map name (from list_property_maps).",
          "name": "map",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Value to store, as a string; parsed per the map's type. Ignored for 'void' maps.",
          "name": "value",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_property"
    },
    {
      "category": "function",
      "category_description": "Decompile, rename, prototype, variables, batch rename, create/delete functions",
      "description": "Set variable storage location. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "method": "POST",
      "params": [
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "function_address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "name": "variable_name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "name": "storage",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_variable_storage"
    },
    {
      "category": "function",
      "category_description": "Decompile, rename, prototype, variables, batch rename, create/delete functions",
      "description": "Set the data type of a function variable (local OR parameter) by name at the decompiler (high-level) layer. Pass variable_name='this' to type a __thiscall/__fastcall implicit this. Replaces set_local_variable_type / set_parameter_type / set_decompiler_variable_type.",
      "method": "POST",
      "params": [
        {
          "name": "function_address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "name": "variable_name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "name": "new_type",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_variable_type"
    },
    {
      "category": "function",
      "category_description": "Decompile, rename, prototype, variables, batch rename, create/delete functions",
      "description": "Set types and names for multiple variables atomically. Types are applied first, then renames, in a single transaction. Hungarian prefix validation is enforced: the new name's prefix must match the type. On programs with multiple address spaces, prefix addresses with the space name.",
      "method": "POST",
      "params": [
        {
          "description": "Function entry point address",
          "name": "function_address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "JSON object mapping old variable names to {name, type} objects. Both fields optional: omit 'type' to rename only, omit 'name' to retype only. Example: {\"local_8\": {\"name\": \"dwFlags\", \"type\": \"uint\"}, \"local_c\": {\"type\": \"int\"}}",
          "name": "variables",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "name": "program",
          "required": true,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_variables"
    },
    {
      "category": "datatype",
      "category_description": "Struct/enum/union CRUD, apply data types, type conflicts, validation",
      "description": "AI-assisted field name suggestions. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "method": "POST",
      "params": [
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "struct_address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "0",
          "name": "struct_size",
