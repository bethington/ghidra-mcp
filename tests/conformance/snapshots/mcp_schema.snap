          "type": "string"
        },
        {
          "description": "Initial register values as JSON: {\"EAX\": \"0x1234\", \"ECX\": \"0x7FFE0000\"}",
          "name": "registers",
          "required": true,
          "source": "body",
          "type": "json"
        },
        {
          "description": "Memory regions to pre-populate as JSON array: [{\"address\": \"0x7FFE0000\", \"data\": \"base64...\"}] or [{\"address\": \"0x7FFE0000\", \"string\": \"CreateProcessW\\u0000\"}]",
          "name": "memory",
          "required": true,
          "source": "body",
          "type": "json"
        },
        {
          "default": "10000",
          "description": "Maximum P-code steps before timeout",
          "name": "max_steps",
          "required": false,
          "source": "body",
          "type": "integer"
        },
        {
          "default": "",
          "description": "Comma-separated register names to return (empty = all general-purpose)",
          "name": "return_registers",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/emulate_function"
    },
    {
      "category": "emulation",
      "category_description": "Targeted function emulation for hash resolution, crypto analysis, and controlled execution of isolated code paths",
      "description": "Brute-force API hash resolution. Emulates a hash function with each candidate API name and returns the one that produces the target hash. Ideal for resolving ROR13, CRC32, djb2, FNV, and custom hash algorithms.",
      "method": "POST",
      "params": [
        {
          "description": "Address of the hash computation function",
          "name": "hash_function_address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Register that receives the pointer to the API name string (e.g., ECX, RCX, EDI)",
          "name": "string_register",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "EAX",
          "description": "Register that contains the computed hash after emulation (e.g., EAX, RAX)",
          "name": "result_register",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Target hash value to match (hex string like 0x7C0DFCAA)",
          "name": "target_hash",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "JSON array of candidate API name strings: [\"CreateProcessW\", \"VirtualAlloc\", ...]",
          "name": "candidates",
          "required": true,
          "source": "body",
          "type": "json"
        },
        {
          "default": "",
          "description": "Additional register values to set before each emulation (JSON object)",
          "name": "initial_registers",
          "required": false,
          "source": "body",
          "type": "json"
        },
        {
          "default": "false",
          "description": "Write candidate strings as UTF-16LE (wide) instead of ASCII",
          "name": "wide_string",
          "required": false,
          "source": "body",
          "type": "boolean"
        },
        {
          "default": "",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/emulate_hash_batch"
    },
