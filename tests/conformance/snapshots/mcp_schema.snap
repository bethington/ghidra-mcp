          "type": "string"
        },
        {
          "description": "Path of the not-yet-versioned file to add.",
          "name": "path",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Check-in comment recorded for the initial version. Defaults to a generic Added via GhidraMCP.",
          "name": "comment",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Accepted but not read on this route — neither handler passes it through. Use /server/version_control/checkin, where it does apply.",
          "name": "keepCheckedOut",
