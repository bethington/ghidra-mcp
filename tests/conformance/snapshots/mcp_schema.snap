    },
    {
      "category": "function",
      "category_description": "Decompile, rename, prototype, variables, batch rename, create/delete functions",
      "description": "Rename a function identified by name OR address. Runs the full naming-quality gate (verb-tier specificity + token-subset collision) with an optional strict_mode override. Replaces rename_function_by_address.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "aliases": [
            "function_address",
            "function",
            "oldName"
          ],
          "description": "Function name or address to rename. Address accepts 0x<hex> or <space>:<hex> (e.g., mem:1000, code:ff00); a plain name resolves by exact function name.",
          "name": "old_name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "New function name in PascalCase, verb first: GetPlayerHealth, not get_player_health and not PlayerHealth. An UPPERCASE module prefix is allowed and validated separately (MODULE_GetValue). The quality gate rejects a vague verb carrying fewer than two specifier tokens (ProcessData), a single-token name (Get), a weak-noun-only name (GetInfo), and a name whose tokens are a strict subset of an existing function's within the same module prefix. strict_mode downgrades those rejections to warnings.",
          "name": "new_name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "Optional per-call override for naming enforcement: 'enforce' (reject low-quality names), 'warn' (write goes through with warnings), or 'off' (skip validation entirely). Omit to use the project/global setting.",
          "name": "strict_mode",
          "required": false,
          "source": "body",
          "type": "string"
        }
      ],
      "path": "/rename_function",
      "read_only": false
    },
    {
      "category": "symbol",
      "category_description": "Create/rename/delete labels, rename data, globals, external locations",
      "description": "Rename a symbol of any kind. kind=auto (default): an address target routes to rename-or-create-label (handles data/label/any symbol at the address); a name target routes to a global. Force with kind=data|global|label|external. For kind=label pass old_name (the current label). Replaces rename_data / rename_global_variable / rename_label / rename_or_label / rename_external_location.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "aliases": [
            "address",
            "function_address"
          ],
          "description": "Address (0x<hex> / <space>:<hex>) or current symbol name to rename. May be omitted when old_name carries the symbol name, which is how the replaced rename_global_variable was called.",
          "name": "target",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "The name to apply. A data global should be g_ + Hungarian + descriptor (g_dwPlayerCount); a code label should be snake_case. Convention misses come back as warnings on an otherwise successful write. IMPORTANT: at a CODE address with no defined data, this ADDS a label rather than renaming one — the existing symbol survives and may stay primary, so the listing can still show the old name after a success. Call delete_label on the old name first when you meant to replace it.",
          "name": "new_name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "auto",
          "description": "auto | data | global | label | external",
          "name": "kind",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "For kind=label: the current label name at the address given by target. When target is omitted this is used as the target instead, for callers migrated from rename_global_variable(old_name, new_name).",
          "name": "old_name",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "Per-call override for the naming-quality gate: 'enforce' rejects a convention miss, 'warn' applies the name and returns the miss as a warning, 'off' skips the check. Omit to use the project/global setting.",
          "name": "strict_mode",
          "required": false,
          "source": "body",
          "type": "string"
        }
      ],
      "path": "/rename_symbol",
      "read_only": false
    },
    {
      "category": "function",
      "category_description": "Decompile, rename, prototype, variables, batch rename, create/delete functions",
      "description": "Rename multiple variables atomically. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "destructive": false,
      "method": "POST",
      "params": [
        {
          "aliases": [
            "address",
            "name",
            "function_address",
            "function_name"
          ],
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "function",
          "param_type": "function_ref",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "JSON object mapping each variable's CURRENT decompiler name to its new name. Matching happens against the decompiler's high-level symbols, so use the names get_function_variables and decompile_function report, not the raw listing's.",
          "name": "variable_renames",
          "required": true,
          "source": "body",
          "type": "object"
        },
        {
          "default": "false",
          "description": "Skip the batched decompiler path and rename each variable on its own via HighFunctionDBUtil. Slower, but it does not commit parameters to the database or suppress events, and it reports per-variable failures instead of losing the whole batch. Use it when the batch path fails or renames the wrong symbol; the response carries \"method\": \"individual\".",
          "name": "force_individual",
          "required": false,
          "source": "body",
          "type": "boolean"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/rename_variables",
      "read_only": false
    },
    {
      "category": "datatype",
