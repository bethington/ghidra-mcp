    {
      "category": "function",
      "category_description": "Decompile, rename, prototype, variables, batch rename, create/delete functions",
      "description": "Disassemble a range of bytes. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution. Returns the disassembled instruction text (mnemonic + operands + bytes) when `include_instructions` is true (default), so callers working on custom processor definitions (#205) can read back what Ghidra produced without a follow-up call.",
      "method": "POST",
      "params": [
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "start_address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "end_address",
          "param_type": "address",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "0",
          "name": "length",
          "required": false,
          "source": "body",
          "type": "integer"
        },
        {
          "default": "true",
          "name": "restrict_to_execute_memory",
          "required": false,
          "source": "body",
          "type": "boolean"
        },
        {
          "default": "true",
          "description": "Return the disassembled instruction list (mnemonic, operands, raw bytes, address) in the response. Disable for byte ranges where you only need the success/byte-count summary.",
          "name": "include_instructions",
          "required": false,
          "source": "body",
          "type": "boolean"
        },
        {
          "default": "1000",
          "description": "Cap on number of instructions returned when include_instructions is true. Protects against runaway payload for large ranges; if the actual count exceeds this, the response sets truncated=true and instructions_total reports the real count.",
          "name": "max_instructions",
          "required": false,
          "source": "body",
          "type": "integer"
        },
        {
          "default": "",
          "name": "program",
