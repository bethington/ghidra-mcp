      "params": [
        {
          "description": "Repository name on the Ghidra Server. Read only by the headless server — the GUI plugin works on the already-open project and ignores it.",
          "name": "repo",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Path of the versioned file to check out.",
