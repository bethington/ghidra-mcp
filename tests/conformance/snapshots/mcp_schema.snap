      "path": "/server/version_history"
    },
    {
      "category": "program",
      "category_description": "Program management, script execution, memory read, bookmarks, save",
      "description": "Create or update a bookmark. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "method": "POST",
      "params": [
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Bookmark category, free text; empty or omitted becomes the literal `Note`. An existing bookmark at this address in the SAME category is replaced, while a different category adds a second bookmark. Everything here is created under Ghidra's Note bookmark type.",
          "name": "category",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Bookmark text. Empty is allowed and stores an empty comment.",
          "name": "comment",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_bookmark"
    },
    {
      "category": "comment",
      "category_description": "Set/get plate, decompiler, disassembly, repeatable comments",
      "description": "Set a listing comment of a given kind at ANY address (data or code). type = plate|pre|eol|post|repeatable (aliases: decompiler=pre, disassembly=eol). Plate writes surface structural warnings and flush the decompiler cache. Symmetric writer for get_comment; replaces the former set_plate_comment / set_decompiler_comment / set_disassembly_comment.",
      "method": "POST",
      "params": [
        {
          "description": "Address in the program (data or code). 0x<hex> or <space>:<hex>.",
          "name": "address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "allow_empty": true,
          "description": "Comment text. An empty string clears this comment kind at the address.",
          "name": "comment",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "plate",
          "description": "Comment kind: plate | pre | eol | post | repeatable (default plate)",
          "name": "type",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_comment"
    },
    {
      "category": "function",
      "category_description": "Decompile, rename, prototype, variables, batch rename, create/delete functions",
      "description": "Mark function as no-return. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "method": "POST",
      "params": [
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "function_address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "aliases": [
            "noReturn"
          ],
          "description": "True marks the function non-returning: its call sites become CALL_TERMINATOR, so control-flow analysis and the decompiler stop showing execution continuing past the call. False clears that back to an ordinary returning function. Required — there is no default.",
          "name": "no_return",
          "required": true,
          "source": "body",
          "type": "boolean"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_function_no_return"
    },
    {
      "category": "function",
      "category_description": "Decompile, rename, prototype, variables, batch rename, create/delete functions",
      "description": "Set function prototype (return type, parameter types, calling convention) by address. NOTE: the function name in the prototype string is used only for parsing — it does NOT rename the function. To rename, call rename_function separately. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "method": "POST",
      "params": [
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "function_address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Full C signature as one string, e.g. int __fastcall Foo(int nCount, char *pszName). The NAME in it is parsed and then discarded — it does NOT rename the function, call rename_function for that. A calling convention written here is only recognised before the first '(', so one inside a callback parameter type survives untouched.",
          "name": "prototype",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Convention to apply — __cdecl, __stdcall, __fastcall, __thiscall and whatever else list_calling_conventions reports for this program's language. When set it OVERRIDES the convention written into the prototype string; omit to use whatever the prototype says.",
          "name": "calling_convention",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_function_prototype"
    },
    {
      "category": "function",
      "category_description": "Decompile, rename, prototype, variables, batch rename, create/delete functions",
      "description": "Update the comment/description on an existing program-wide function tag.",
      "method": "POST",
      "params": [
        {
          "description": "Tag name",
          "name": "name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "New comment text (pass an empty string to clear)",
          "name": "comment",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_function_tag_comment"
    },
    {
      "category": "function",
      "category_description": "Decompile, rename, prototype, variables, batch rename, create/delete functions",
      "description": "Type the implicit 'this' of a __thiscall/__fastcall member function by associating the function with its class. Ghidra's auto-'this' (ECX on x86) is an immutable auto-parameter; with auto-storage it derives its type from the function's parent Class namespace, matched by name to a same-named structure. This tool finds/creates a class namespace for the struct and moves the function into it (no custom storage). Pass 'MyClass *' or 'MyClass'; the structure MyClass must already exist (create_struct). On programs with multiple address spaces, prefix function_address with the space name (mem:1000).",
      "method": "POST",
      "params": [
        {
          "description": "Function entry address (0x<hex> or <space>:<hex>).",
          "name": "function_address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "aliases": [
            "thisType"
          ],
          "description": "Class type for this, e.g. 'MyWidget *' or 'MyWidget'. The base struct name becomes the function's class.",
          "name": "this_type",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_function_this_type"
    },
    {
      "category": "datatype",
      "category_description": "Struct/enum/union CRUD, apply data types, type conflicts, validation",
      "description": "Atomically apply name + type + plate-comment + array length to a global variable. Single-transaction; rejects on validation failure with no partial write. Replaces the 4-tool chain (apply_data_type → rename_data → batch_set_comments → create_label).",
      "method": "POST",
      "params": [
        {
          "description": "Address of the global. Accepts 0x<hex> (default space) or <space>:<hex>.",
          "name": "address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "New name. Must follow g_ + Hungarian + descriptor convention (e.g., g_dwActiveQuestState, g_pUnitList).",
          "name": "name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Ghidra data type to apply (e.g., uint, byte, UnitAny *, char *, MyStruct). Use create_struct/create_array_type first if the type doesn't exist. Pass empty to leave type unchanged.",
          "name": "type_name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "0",
          "description": "If >0, applied as an array of array_length elements of type_name. Required when documenting an array of fixed length (e.g., a 100-entry data table).",
          "name": "array_length",
          "required": false,
          "source": "body",
          "type": "integer"
        },
        {
          "description": "Plate comment for the address. First line must be a meaningful one-line summary (≥4 words). Optional sectioned details (Used by:, Layout:, Source:, Bitfield:) follow when applicable. Pass empty to leave plate comment unchanged.",
          "name": "plate_comment",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "Optional per-call override for naming enforcement: 'enforce' / 'warn' / 'off'. Omit to use the project/global setting.",
          "name": "strict_mode",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "false",
          "description": "Permit this type application to clear NAMED neighbouring globals out of existence. Default false: the call is rejected with `type_would_evict` plus the list of globals it would destroy. Only set true when the overlap is genuinely wrong and the other symbol should go — the default exists because a silent clear deletes another global's documentation and still reports success.",
          "name": "allow_evict",
          "required": false,
          "source": "body",
          "type": "boolean"
        }
      ],
      "path": "/set_global"
    },
    {
      "category": "program",
      "category_description": "Program management, script execution, memory read, bookmarks, save",
      "description": "Set the base address of the program (rebases all addresses)",
      "method": "POST",
      "params": [
        {
          "description": "New base address (e.g. 0x08000000)",
          "name": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_image_base"
    },
    {
      "category": "program",
      "category_description": "Program management, script execution, memory read, bookmarks, save",
      "description": "Set a typed program option. If the option already exists its type is reused; otherwise pass type (string|int|long|double|float|boolean). New/custom options are created on demand. Call save_program to persist.",
      "method": "POST",
      "params": [
        {
          "description": "Option group name (e.g. 'Program Information'). Use list_option_groups to discover names.",
          "name": "group",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Option name within the group.",
          "name": "name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "New value as a string; parsed according to the option type.",
          "name": "value",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Value type: string|int|long|double|float|boolean. Optional when the option already exists (its current type is reused); defaults to string for a brand-new option.",
          "name": "type",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_program_option"
    },
    {
      "category": "program",
      "category_description": "Program management, script execution, memory read, bookmarks, save",
      "description": "Set a value at an address in a property map. The value is coerced to the map's type (int/long/string); 'void' maps ignore the value and just tag the address. Create the map first with create_property_map. Call save_program to persist.",
      "method": "POST",
      "params": [
        {
          "description": "Property map name (from list_property_maps).",
          "name": "map",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Value to store, as a string; parsed per the map's type. Ignored for 'void' maps.",
          "name": "value",
          "required": false,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_property"
    },
    {
      "category": "function",
      "category_description": "Decompile, rename, prototype, variables, batch rename, create/delete functions",
      "description": "Set a parameter's or local's storage location to a register, register pair, or stack slot. Accepts 'EAX', 'EAX:4', 'R0:4,R2:4' or 'Stack[-0x10]:4'; size defaults to the variable's data-type length. Use this when the argument layout cannot be expressed by any calling convention. Setting a PARAMETER's storage switches the whole function to custom variable storage (reported as custom_storage_enabled). The storage is read back after the write and returned in 'storage'. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "method": "POST",
      "params": [
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "function_address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Local or parameter to address, matched by exact name against the function's variables.",
          "name": "variable_name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Storage specification: a location followed by a size in bytes, e.g. Stack[-0x10]:4, EBP:4, EAX:4. The response echoes it as requested_storage next to the variable's current_storage.",
          "name": "storage",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_variable_storage"
    },
    {
      "category": "function",
      "category_description": "Decompile, rename, prototype, variables, batch rename, create/delete functions",
      "description": "Set the data type of a function variable (local OR parameter) by name at the decompiler (high-level) layer. Pass variable_name='this' to type a __thiscall/__fastcall implicit this. Replaces set_local_variable_type / set_parameter_type / set_decompiler_variable_type.",
      "method": "POST",
      "params": [
        {
          "description": "Entry address of the function that owns the variable. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00); use get_address_spaces first on targets that are not address-space-agnostic.",
          "name": "function_address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "aliases": [
            "parameter_name"
          ],
          "description": "Local or parameter to retype, named exactly as the decompiler shows it (get_function_variables lists them). The literal value 'this' is special-cased and routes to set_function_this_type.",
          "name": "variable_name",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "New data type, resolved recursively (pointer chains, array syntax such as dword[8], existing struct/enum names). A type starting with `undefined` is REJECTED whatever the current type is — swapping one undefined width for another is a no-op, not documentation. For 'this', a bare struct name is auto-suffixed with ' *'.",
          "name": "new_type",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_variable_type"
    },
    {
      "category": "function",
      "category_description": "Decompile, rename, prototype, variables, batch rename, create/delete functions",
      "description": "Set types and names for multiple variables atomically. Types are applied first, then renames, in a single transaction. Hungarian prefix validation is enforced: the new name's prefix must match the type. On programs with multiple address spaces, prefix addresses with the space name.",
      "method": "POST",
      "params": [
        {
          "description": "Function entry point address",
          "name": "function_address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "JSON object mapping old variable names to {name, type} objects. Both fields optional: omit 'type' to rename only, omit 'name' to retype only. Example: {\"local_8\": {\"name\": \"dwFlags\", \"type\": \"uint\"}, \"local_c\": {\"type\": \"int\"}}",
          "name": "variables",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": true,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/set_variables"
    },
    {
      "category": "datatype",
      "category_description": "Struct/enum/union CRUD, apply data types, type conflicts, validation",
      "description": "AI-assisted field name suggestions. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "method": "POST",
      "params": [
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "struct_address",
          "param_type": "address",
          "required": true,
          "source": "body",
          "type": "string"
        },
        {
          "default": "0",
          "description": "Size of the structure in BYTES, or 0 (the default) to take the size from the data already applied at struct_address. Must be 0 to 65536.",
          "name": "struct_size",
          "required": false,
          "source": "body",
          "type": "integer"
        },
        {
          "default": "",
          "description": "Target program name",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/suggest_field_names"
    },
    {
      "category": "program",
      "category_description": "Program management, script execution, memory read, bookmarks, save",
      "description": "Switch MCP context to a different program",
      "method": "GET",
      "params": [
        {
          "description": "Program name to switch to",
          "name": "program",
          "required": true,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/switch_program"
    },
    {
      "category": "utility",
      "description": "Navigate CodeBrowser listing and decompiler to a specific address",
      "method": "POST",
      "params": [
        {
          "description": "Address to navigate to, as 0x<hex> or <space>:<hex>. GUI mode only — it moves a CodeBrowser window.",
          "name": "address",
          "required": false,
          "source": "body",
          "type": "string"
        }
      ],
      "path": "/tool/goto_address"
    },
    {
      "category": "utility",
      "description": "Open a file in CodeBrowser, launching a new one if needed",
      "method": "POST",
      "params": [
        {
          "description": "DomainFile path of the program to open, e.g. /Vanilla/1.13c/D2Common.dll. GUI mode only.",
          "name": "path",
          "required": false,
          "source": "body",
          "type": "string"
        }
      ],
      "path": "/tool/launch_codebrowser"
    },
    {
      "category": "utility",
      "description": "List all running Ghidra tool windows",
      "method": "GET",
      "params": [],
      "path": "/tool/running_tools"
    },
    {
      "category": "datatype",
      "category_description": "Struct/enum/union CRUD, apply data types, type conflicts, validation",
      "description": "Validate a data type. With an address: checks applicability (memory range, alignment, conflicts) at that address. Without an address: checks only that the type exists, resolving bare names like 'int'/'DWORD'/'char *' across all categories. Replaces validate_data_type_exists.",
      "method": "GET",
      "params": [
        {
          "default": "",
          "description": "Optional address. Omit to check type existence only; provide to validate applicability at that address (memory range/alignment/conflicts). Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00).",
          "name": "address",
          "param_type": "address",
          "required": false,
          "source": "query",
          "type": "string"
        },
        {
          "description": "Data type name (bare names resolve across all categories)",
          "name": "type_name",
          "required": true,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/validate_data_type"
    },
    {
      "category": "datatype",
      "category_description": "Struct/enum/union CRUD, apply data types, type conflicts, validation",
      "description": "Validate prototype before applying. On programs with multiple address spaces (e.g., embedded targets), prefix addresses with the space name (mem:1000) to avoid ambiguous resolution.",
      "method": "GET",
      "params": [
        {
          "description": "Address in the program. Accepts 0x<hex> (default space) or <space>:<hex> (e.g., mem:1000, code:ff00). Note: some programs — particularly embedded/microcontroller targets — are not address-space-agnostic; use get_address_spaces to discover spaces before assuming a plain hex address is unambiguous.",
          "name": "function_address",
          "param_type": "address",
          "required": true,
          "source": "query",
          "type": "string"
        },
        {
          "description": "Function prototype",
          "name": "prototype",
          "required": true,
          "source": "query",
          "type": "string"
        },
        {
          "description": "Calling convention",
          "name": "calling_convention",
          "required": true,
          "source": "query",
          "type": "string"
        },
        {
          "default": "",
          "description": "Target program name (omit to use the active program — always specify when multiple programs are open)",
          "name": "program",
          "required": false,
          "source": "query",
          "type": "string"
        }
      ],
      "path": "/validate_function_prototype"
    }
  ]
}