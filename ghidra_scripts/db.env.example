# BSim database connection for the Analyze_BSimStep0-Step5 scripts.
#
# Copy to db.env and fill in. db.env is gitignored and MUST stay that way --
# it holds a real password, and this repo is public. The scripts also accept
# GHIDRA_MCP_BSIM_URL from the environment, which is preferred: it keeps the
# credential out of the working tree entirely.
BSIM_DB_HOST=your-bsim-host
BSIM_DB_PORT=5432
BSIM_DB_NAME=bsim
BSIM_DB_USER=your-user
BSIM_DB_PASSWORD=your-password
